    <!-- CLIENT CONTROLLER SCRIPT -->
    <script>
      import { Scheduler, isPremiumFormat } from '../core/scheduler';
      import { PassType, type Cinema, type Showtime, type PlanCriteria, type Itinerary } from '../core/models';
      import {
        formatItineraryCardHtml,
        formatThermalReceiptHtml,
        ACTIVE_CARD_CLASS,
        INACTIVE_CARD_CLASS,
        getSelectionStampHtml,
      } from '../components/ItineraryCard';
      import { loadPreferences, savePreferences, clearPreferences } from '../core/storage';
      import { normalizeText, formatCityShort } from '../core/parser_utils';
      import { escapeHtml, renderAllocineRatingsBadge } from '../components/Badge';
      import { getStoredLanguage, setStoredLanguage, t, formatDateLocalized, formatOrdinal, type Lang } from '../core/i18n';
      import {
        iconAlert,
        iconBuilding,
        iconStar4,
        iconZap,
        iconClock,
        iconSparkles,
        iconWrench,
        iconComposer,
        iconGrip,
        iconStar5,
        iconNewspaper,
        iconFilm,
        iconPin,
        iconCheck,
        iconRefresh,
      } from '../components/Icons';

      const BASE_PATH = import.meta.env.BASE_URL.replace(/\/?$/, '/');

      let currentLang: Lang = getStoredLanguage();
      let allCinemas: Cinema[] = [];
      let allDates: string[] = [];
      let currentShowtimesMap: Record<string, any[]> = {};
      const showtimesJsonCache = new Map<string, Record<string, any[]>>();
      let movieRatingsMap: Record<string, { user_rating: number | null; press_rating: number | null }> = {};
      let selectedCinemaIds: Set<string> = new Set();
      let selectedPriorityMovies: Set<string> = new Set();
      let selectedSeenMovies: Set<string> = new Set();
      let calculatedPlans: Itinerary[] = [];
      let activePlanIndex = 0;
      let activeScenario: string = 'optimal';
      let cinemaSearchFilter = '';
      let prioritySearchFilter = '';
      let priorityMovieScope: 'selected' | 'all_day' = 'selected';

      // Builder / Composition Mode State Machine
      let builderModeActive = false;
      let builderSlots: (Showtime | null)[] = [];
      let builderPinnedIndex: number = 0;
      let drawerTargetSlot: number | null = null;
      let drawerMode: 'choose_start_movie' | 'choose_slot_showtime' = 'choose_slot_showtime';
      let drawerCandidates: Array<{ showtime: Showtime; gapBeforeMinutes: number; gapAfterMinutes: number }> = [];
      let drawerFilterText = '';
      let draggedSlotIndex: number | null = null;
      let builderProposalCycleIndex: number = 0;
      let cachedBuilderProposals: Itinerary[] = [];
      let lastBuilderPinnedSignature: string = '';

      function getTargetCount(): number {
        const countInput = document.getElementById('range-count') as HTMLInputElement;
        return parseInt(countInput?.value, 10) || 3;
      }

      function syncBuilderSlotsLength() {
        const target = Math.max(1, getTargetCount());
        if (builderSlots.length === 0) {
          builderSlots = new Array(target).fill(null);
        } else if (builderSlots.length < target) {
          while (builderSlots.length < target) {
            builderSlots.push(null);
          }
        } else if (builderSlots.length > target) {
          builderSlots = builderSlots.slice(0, target);
          if (builderPinnedIndex >= target) {
            builderPinnedIndex = target - 1;
          }
        }
      }

      let recalculateTimer: ReturnType<typeof setTimeout> | null = null;
      let persistDebounceTimer: ReturnType<typeof setTimeout> | null = null;

      function scheduleRecalculate(delay = 50) {
        if (recalculateTimer) {
          clearTimeout(recalculateTimer);
        }
        if (delay === 0) {
          recalculate();
        } else {
          recalculateTimer = setTimeout(() => {
            recalculate();
          }, delay);
        }
      }

      function schedulePersistPreferences(delay = 250) {
        if (persistDebounceTimer) {
          clearTimeout(persistDebounceTimer);
        }
        persistDebounceTimer = setTimeout(() => {
          persistCurrentPreferences();
        }, delay);
      }

      const scheduler = new Scheduler();

      async function init() {
        const prefs = loadPreferences();
        const urlParams = new URLSearchParams(window.location.search);
        const qCity = urlParams.get('city') || prefs.city;
        const qPass = urlParams.get('pass') || prefs.pass_formula;
        const qLang = urlParams.get('lang') || prefs.language;
        const qCountRaw = urlParams.get('count');
        const qCount = qCountRaw ? parseInt(qCountRaw, 10) : prefs.target_count;
        if (prefs.scenario) {
          activeScenario = prefs.scenario;
        }
        if (prefs.seen_movies && Array.isArray(prefs.seen_movies)) {
          prefs.seen_movies.forEach(m => selectedSeenMovies.add(m));
        }
        if (prefs.priority_movies && Array.isArray(prefs.priority_movies)) {
          prefs.priority_movies.forEach(m => selectedPriorityMovies.add(m));
        }

        try {
          const [cinResp, datesResp, ratingsResp] = await Promise.all([
            fetch(`${BASE_PATH}data/cinemas.json`),
            fetch(`${BASE_PATH}data/dates.json`),
            fetch(`${BASE_PATH}data/ratings.json`).catch(() => null),
          ]);

          allCinemas = await cinResp.json();
          allDates = await datesResp.json();
          if (ratingsResp && ratingsResp.ok) {
            try {
              movieRatingsMap = await ratingsResp.json();
            } catch (e) {
              movieRatingsMap = {};
            }
          }

          // Populate Cities
          const citySelect = document.getElementById('select-city') as HTMLSelectElement;
          const uniqueCities = Array.from(new Set(allCinemas.map(c => c.city).filter(Boolean))).sort();
          for (const city of uniqueCities) {
            const opt = document.createElement('option');
            opt.value = city;
            opt.textContent = formatCityShort(city);
            citySelect.appendChild(opt);
          }

          if (qCity && (qCity === 'Toutes' || uniqueCities.includes(qCity))) {
            citySelect.value = qCity;
          }

          // Populate Dates
          const dateSelect = document.getElementById('select-date') as HTMLSelectElement;
          dateSelect.innerHTML = '';
          const todayStr = new Date().toISOString().slice(0, 10);

          if (allDates.length === 0) {
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = t('noShowtimesDateTitle', currentLang);
            dateSelect.appendChild(opt);
          } else {
            for (const d of allDates) {
              const opt = document.createElement('option');
              opt.value = d;
              opt.textContent = formatDateLocalized(d, currentLang);
              dateSelect.appendChild(opt);
            }

            const defaultDate = allDates.find(d => d >= todayStr) || allDates[0] || '';
            dateSelect.value = defaultDate;
          }

          // Restore preferences into inputs
          if (qPass) {
            const radio = document.querySelector(`input[name="pass-type"][value="${qPass}"]`) as HTMLInputElement;
            if (radio) radio.checked = true;
          }
          if (prefs.allow_supplements !== undefined) {
            (document.getElementById('check-supplements') as HTMLInputElement).checked = prefs.allow_supplements;
          }
          if (qLang) {
            const radio = document.querySelector(`input[name="lang-filter"][value="${qLang}"]`) as HTMLInputElement;
            if (radio) radio.checked = true;
          }
          if (qCount) {
            (document.getElementById('range-count') as HTMLInputElement).value = String(qCount);
            (document.getElementById('target-count-val') as HTMLElement).textContent = t('targetCountText', currentLang, { n: qCount });
          }
          if (prefs.start_time) {
            (document.getElementById('input-start') as HTMLInputElement).value = prefs.start_time;
          }
          if (prefs.end_time) {
            (document.getElementById('input-end') as HTMLInputElement).value = prefs.end_time;
          }
          if (prefs.require_meal !== undefined) {
            (document.getElementById('check-meal') as HTMLInputElement).checked = prefs.require_meal;
          }
          if (prefs.min_buffer !== undefined) {
            (document.getElementById('input-buffer') as HTMLInputElement).value = String(prefs.min_buffer);
          }
          if (prefs.selected_formats) {
            document.querySelectorAll('.format-check').forEach((cb: any) => {
              cb.checked = prefs.selected_formats!.includes(cb.value);
            });
          }

          // Restore selected cinemas
          if (prefs.selected_cinemas && prefs.selected_cinemas.length > 0) {
            const validIds = new Set(allCinemas.map(c => c.id));
            prefs.selected_cinemas.forEach(id => {
              if (validIds.has(id)) {
                selectedCinemaIds.add(id);
              }
            });
          }

          if (selectedCinemaIds.size === 0 && allCinemas.length > 0) {
            const citySelect = document.getElementById('select-city') as HTMLSelectElement;
            const chosenCity = citySelect?.value || 'Toutes';
            if (chosenCity !== 'Toutes') {
              const cityCinemas = allCinemas.filter(c => c.city === chosenCity);
              cityCinemas.forEach(c => selectedCinemaIds.add(c.id));
            } else {
              const parisCinemas = allCinemas.filter(c => c.city === 'PARIS - ILE DE FRANCE');
              if (parisCinemas.length > 0) {
                parisCinemas.forEach(c => selectedCinemaIds.add(c.id));
              } else {
                selectedCinemaIds.add(allCinemas[0].id);
              }
            }
          }

          applyLanguage(currentLang);
          setupEventListeners();
          await onDateOrCinemaChanged();
        } catch (e) {
          console.error('Failed to initialize planner', e);
          const results = document.getElementById('results-container')!;
          results.innerHTML = `
            <div class="neo-card bg-[#F9A8B8] p-6 text-center text-xs text-[#111111] font-bold flex flex-col items-center gap-2">
              ${iconAlert('w-6 h-6 text-[#111111]')}
              <span>${t('syncErrorMessage', currentLang)}</span>
            </div>
          `;
        }
      }

      function applyLanguage(lang: Lang) {
        currentLang = lang;
        setStoredLanguage(lang);
        document.documentElement.lang = lang;

        // Header buttons toggle
        const btnFr = document.getElementById('btn-lang-fr');
        const btnEn = document.getElementById('btn-lang-en');
        if (btnFr && btnEn) {
          if (lang === 'fr') {
            btnFr.className = 'btn-lang px-2.5 py-0.5 rounded-full text-xs font-mono font-black border border-transparent cursor-pointer bg-[#FFE566] text-[#111111] border-[#111111] transition-all';
            btnEn.className = 'btn-lang px-2.5 py-0.5 rounded-full text-xs font-mono font-black border border-transparent cursor-pointer text-[#555555] hover:text-[#111111] transition-all';
          } else {
            btnEn.className = 'btn-lang px-2.5 py-0.5 rounded-full text-xs font-mono font-black border border-transparent cursor-pointer bg-[#FFE566] text-[#111111] border-[#111111] transition-all';
            btnFr.className = 'btn-lang px-2.5 py-0.5 rounded-full text-xs font-mono font-black border border-transparent cursor-pointer text-[#555555] hover:text-[#111111] transition-all';
          }
        }

        // Header texts
        const elTagline = document.getElementById('header-tagline');
        if (elTagline) elTagline.textContent = t('taglineBadge', lang);
        const elHandnote = document.getElementById('header-handnote');
        if (elHandnote) elHandnote.textContent = t('handNote', lang);
        const elSubtitle = document.getElementById('header-subtitle');
        if (elSubtitle) elSubtitle.textContent = t('subtitle', lang);
        const elSynced = document.getElementById('header-synced');
        if (elSynced) elSynced.textContent = t('syncedBadge', lang);

        // Sidebar elements
        const elSettingsTitle = document.getElementById('settings-panel-title');
        if (elSettingsTitle) elSettingsTitle.textContent = t('settingsTitle', lang);
        const elResetBtn = document.getElementById('btn-reset');
        if (elResetBtn) {
          elResetBtn.textContent = t('resetBtn', lang);
          elResetBtn.title = t('resetTitle', lang);
        }
        const elSearchLabel = document.getElementById('label-cinema-search');
        if (elSearchLabel) elSearchLabel.textContent = t('searchCinemaLabel', lang);
        const elSearchInput = document.getElementById('input-cinema-search') as HTMLInputElement;
        if (elSearchInput) elSearchInput.placeholder = t('searchCinemaPlaceholder', lang);
        const elClearSearch = document.getElementById('btn-clear-search');
        if (elClearSearch) elClearSearch.title = t('clearSearch', lang);

        const elSelectedChipsLabel = document.getElementById('label-selected-chips');
        if (elSelectedChipsLabel) elSelectedChipsLabel.textContent = `${t('selectedCinemasHeader', lang)} :`;

        const elCityLabel = document.getElementById('label-city-filter');
        if (elCityLabel) elCityLabel.textContent = lang === 'en' ? 'filter by city' : 'filtrer par ville';
        const citySelect = document.getElementById('select-city') as HTMLSelectElement;
        if (citySelect && citySelect.options.length > 0) {
          citySelect.options[0].textContent = t('allCities', lang);
        }

        const elCinemasListLabel = document.getElementById('label-cinemas-list');
        if (elCinemasListLabel) elCinemasListLabel.textContent = lang === 'en' ? 'available cinemas' : 'cinémas disponibles';

        const elDateLabel = document.getElementById('label-date-select');
        if (elDateLabel) elDateLabel.textContent = t('dateLabel', lang);
        updateDateOptionsLabels();

        const elFormulaLabel = document.getElementById('label-pass-formula');
        if (elFormulaLabel) elFormulaLabel.textContent = t('passFormulaLabel', lang);
        const elSupplementsSpan = document.getElementById('label-supplements-text');
        if (elSupplementsSpan) elSupplementsSpan.textContent = t('allowSupplementsText', lang);

        const elLangFilterLabel = document.getElementById('label-lang-filter');
        if (elLangFilterLabel) elLangFilterLabel.textContent = t('langFilterTitle', lang);
        const elRadioAllSpan = document.getElementById('radio-lang-all-text');
        if (elRadioAllSpan) elRadioAllSpan.textContent = t('langAll', lang);

        const elFormatsLabel = document.getElementById('label-formats-filter');
        if (elFormatsLabel) elFormatsLabel.textContent = t('techFormatsTitle', lang);

        const elCountLabel = document.getElementById('label-target-count');
        if (elCountLabel) elCountLabel.textContent = `${t('countLabel', lang)} :`;
        const rangeCount = (document.getElementById('range-count') as HTMLInputElement)?.value || '3';
        const elCountVal = document.getElementById('target-count-val');
        if (elCountVal) elCountVal.textContent = t('targetCountText', lang, { n: rangeCount });

        const elStartLabel = document.getElementById('label-time-start');
        if (elStartLabel) elStartLabel.textContent = t('startTimeLabel', lang);
        const elEndLabel = document.getElementById('label-time-end');
        if (elEndLabel) elEndLabel.textContent = t('endTimeLabel', lang);

        const elMealSpan = document.getElementById('label-meal-break-text');
        if (elMealSpan) elMealSpan.textContent = `${t('mealBreakLabel', lang)} (${t('mealBreakHint', lang)})`;
        const elBufferLabel = document.getElementById('label-buffer');
        if (elBufferLabel) elBufferLabel.textContent = t('minBufferLabel', lang);

        // Priority movies
        const elPriorityTitle = document.getElementById('priority-movies-title');
        if (elPriorityTitle) elPriorityTitle.textContent = t('priorityTitle', lang);
        const elPriorityFilter = document.getElementById('input-priority-filter') as HTMLInputElement;
        if (elPriorityFilter) elPriorityFilter.placeholder = t('prioritySearchPlaceholder', lang);
        const elClearPriority = document.getElementById('btn-clear-priority');
        if (elClearPriority) {
          elClearPriority.textContent = t('clearPriorityBtn', lang);
          elClearPriority.title = t('clearPriorityTitle', lang);
        }

        // Seen movies
        const elSeenTitle = document.getElementById('seen-movies-title');
        if (elSeenTitle) elSeenTitle.textContent = t('seenMoviesTitle', lang);
        const elClearSeen = document.getElementById('btn-clear-seen');
        if (elClearSeen) {
          elClearSeen.textContent = t('clearSeenBtn', lang);
          elClearSeen.title = t('clearSeenTitle', lang);
        }

        // Footer
        const elFooterSub = document.getElementById('footer-sub');
        if (elFooterSub) elFooterSub.textContent = t('footerSub', lang);
        const elFooterMeta = document.getElementById('footer-meta');
        if (elFooterMeta) elFooterMeta.textContent = t('footerMeta', lang);

        // Builder Mode Panel & Controls
        const toggleBtn = document.getElementById('btn-toggle-builder');
        if (toggleBtn) toggleBtn.title = t('builderToggleTitle', lang);
        const toggleLabel = document.getElementById('btn-builder-label');
        if (toggleLabel) {
          toggleLabel.textContent = builderModeActive
            ? t('builderToggleBtnActive', lang)
            : t('builderToggleBtn', lang);
        }

        const elBuilderTitle = document.getElementById('builder-panel-title');
        if (elBuilderTitle) elBuilderTitle.textContent = t('builderTitle', lang);
        const elBuilderBadge = document.getElementById('builder-panel-badge');
        if (elBuilderBadge) elBuilderBadge.textContent = t('builderBadge', lang);
        const elBuilderSubtitle = document.getElementById('builder-panel-subtitle');
        if (elBuilderSubtitle && !cachedBuilderProposals.length) {
          elBuilderSubtitle.textContent = t('builderSubtitleDefault', lang);
        }
        const elRecomputeBtn = document.getElementById('btn-builder-recompute');
        if (elRecomputeBtn) elRecomputeBtn.title = t('builderRecomputeTitle', lang);
        const elRecomputeLabel = document.getElementById('btn-builder-recompute-label');
        if (elRecomputeLabel) elRecomputeLabel.textContent = t('builderRecomputeBtn', lang);
        const elCloseBuilderBtn = document.getElementById('btn-close-builder');
        if (elCloseBuilderBtn) elCloseBuilderBtn.title = t('builderCloseTitle', lang);
        const elCloseBuilderLabel = document.getElementById('btn-close-builder-label');
        if (elCloseBuilderLabel) elCloseBuilderLabel.textContent = t('builderCloseBtn', lang);

        const elDrawerFilter = document.getElementById('input-drawer-filter') as HTMLInputElement;
        if (elDrawerFilter) elDrawerFilter.placeholder = t('builderDrawerSearchPlaceholder', lang);
        const elCloseDrawer = document.getElementById('btn-close-drawer');
        if (elCloseDrawer) elCloseDrawer.title = t('builderDrawerCloseTitle', lang);

        updateScenarioTabsUI();
        renderCinemasList();
        renderSelectedCinemasChips();
        renderSeenMovies();
        renderPriorityMovies();

        if (builderModeActive) {
          recomputeBuilderProposals(false);
          renderBuilderPanel();
          renderBuilderThermalReceipt();
        } else {
          recalculate();
        }
      }

      function updateDateOptionsLabels() {
        const dateSelect = document.getElementById('select-date') as HTMLSelectElement;
        if (!dateSelect) return;
        for (let i = 0; i < dateSelect.options.length; i++) {
          const opt = dateSelect.options[i];
          if (opt.value) {
            opt.textContent = formatDateLocalized(opt.value, currentLang);
          }
        }
      }

      function updateScenarioTabsUI() {
        document.querySelectorAll('.scenario-tab').forEach((tab: any) => {
          const s = tab.getAttribute('data-scenario');
          const isOptimal = s === 'optimal';
          const isSameCinema = s === 'same_cinema';
          const iconSvg = isOptimal
            ? iconZap('w-3.5 h-3.5')
            : (isSameCinema ? iconBuilding('w-3.5 h-3.5') : iconClock('w-3.5 h-3.5'));

          const label = isOptimal
            ? t('scenarioOptimal', currentLang)
            : (isSameCinema ? t('scenarioSameCinema', currentLang) : t('scenarioShortBreaks', currentLang));

          if (s === activeScenario) {
            tab.className = 'scenario-tab neo-btn px-4 py-2 rounded-full text-xs font-bold bg-[#FFE566] text-[#111111] border-2 border-[#111111] shadow-[2px_2px_0px_0px_#111111] flex items-center gap-2 shrink-0 cursor-pointer';
          } else {
            tab.className = 'scenario-tab neo-btn px-4 py-2 rounded-full text-xs font-bold bg-white text-[#111111] border-2 border-[#111111] shadow-[2px_2px_0px_0px_#111111] flex items-center gap-2 shrink-0 hover:bg-[#FAFADF] cursor-pointer';
          }
          tab.innerHTML = `${iconSvg}<span>${label}</span>`;
        });
      }

      function renderCinemasList() {
        const cityFilter = (document.getElementById('select-city') as HTMLSelectElement).value;
        const container = document.getElementById('cinemas-list')!;
        container.innerHTML = '';

        const cleanSearch = normalizeText(cinemaSearchFilter);

        const visibleCinemas = allCinemas.filter(c => {
          if (cleanSearch) {
            const matchesSearch = normalizeText(c.name).includes(cleanSearch) || normalizeText(c.city).includes(cleanSearch);
            if (cityFilter !== 'Toutes' && c.city !== cityFilter) {
              return false;
            }
            return matchesSearch;
          }

          if (cityFilter === 'Toutes') return true;
          return c.city === cityFilter || selectedCinemaIds.has(c.id);
        });

        visibleCinemas.sort((a, b) => {
          const aChecked = selectedCinemaIds.has(a.id) ? 1 : 0;
          const bChecked = selectedCinemaIds.has(b.id) ? 1 : 0;
          if (aChecked !== bChecked) return bChecked - aChecked;
          return a.name.localeCompare(b.name);
        });

        if (visibleCinemas.length === 0) {
          container.innerHTML = `<p class="text-[#777777] text-center py-4 font-mono text-xs">${t('noCinemaFound', currentLang)} "${escapeHtml(cinemaSearchFilter)}"</p>`;
          updateSelectedCinemasCount();
          return;
        }

        for (const cin of visibleCinemas) {
          const isChecked = selectedCinemaIds.has(cin.id);
          const label = document.createElement('label');
          label.className = `flex items-center justify-between gap-2 p-1.5 rounded-[6px] border border-transparent hover:border-[#111111] hover:bg-white cursor-pointer text-xs transition-colors min-w-0 ${
            isChecked ? 'bg-[#FFE566]/30 font-bold border-[#111111]/40' : ''
          }`;
          label.innerHTML = `
            <div class="flex items-center gap-2 min-w-0 flex-1">
              <input type="checkbox" value="${cin.id}" class="cinema-checkbox w-3.5 h-3.5 accent-[#E8635A] rounded border border-[#111111] cursor-pointer shrink-0" ${isChecked ? 'checked' : ''} />
              <span class="truncate ${isChecked ? 'text-[#111111] font-bold' : 'text-[#333333]'}" title="${escapeHtml(cin.name)}">${escapeHtml(cin.name)}</span>
            </div>
            <span class="text-[0.65rem] text-[#777777] font-mono shrink-0 ml-1.5">${escapeHtml(formatCityShort(cin.city))}</span>
          `;

          const checkbox = label.querySelector('input')!;
          checkbox.addEventListener('change', () => {
            if (checkbox.checked) {
              selectedCinemaIds.add(cin.id);
            } else {
              selectedCinemaIds.delete(cin.id);
            }
            updateSelectedCinemasCount();
            renderSelectedCinemasChips();
            renderCinemasList();
            renderPriorityMovies();
            recalculate();
          });

          container.appendChild(label);
        }

        updateSelectedCinemasCount();
      }

      function renderSelectedCinemasChips() {
        const wrapper = document.getElementById('selected-cinemas-chips-wrapper');
        const container = document.getElementById('selected-cinemas-chips');
        if (!wrapper || !container) return;

        if (selectedCinemaIds.size === 0) {
          wrapper.classList.add('hidden');
          container.innerHTML = '';
          return;
        }

        wrapper.classList.remove('hidden');
        container.innerHTML = '';

        const cinemasById = new Map(allCinemas.map(c => [c.id, c]));

        for (const cid of selectedCinemaIds) {
          const cin = cinemasById.get(cid);
          if (!cin) continue;

          const chip = document.createElement('span');
          chip.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[0.68rem] font-bold bg-[#FFE566] text-[#111111] border border-[#111111] shadow-[1px_1px_0px_0px_#111111] max-w-full';
          chip.innerHTML = `
            <span class="truncate max-w-[130px] font-sans" title="${escapeHtml(cin.name)}">${escapeHtml(cin.name)}</span>
            <button type="button" class="btn-remove-chip cursor-pointer text-[#E8635A] hover:scale-125 font-black text-xs leading-none transition-transform" data-cinema-id="${cin.id}" title="${t('removeCinemaTitle', currentLang)}">✕</button>
          `;

          chip.querySelector('button')!.addEventListener('click', (ev) => {
            ev.stopPropagation();
            selectedCinemaIds.delete(cin.id);
            updateSelectedCinemasCount();
            renderSelectedCinemasChips();
            renderCinemasList();
            renderPriorityMovies();
            recalculate();
          });

          container.appendChild(chip);
        }
      }

      function updateSelectedCinemasCount() {
        const countSpan = document.getElementById('selected-cinemas-count')!;
        countSpan.textContent = `${selectedCinemaIds.size} ${t('selectedCinemasCount', currentLang)}${selectedCinemaIds.size > 1 && currentLang === 'fr' ? 's' : ''}`;
      }

      function renderSeenMovies() {
        const container = document.getElementById('seen-movies-container')!;
        const countSpan = document.getElementById('seen-movies-count')!;
        const clearBtn = document.getElementById('btn-clear-seen')!;
        container.innerHTML = '';

        countSpan.textContent = `${selectedSeenMovies.size} ${currentLang === 'en' ? 'excluded' : 'exclu'}${selectedSeenMovies.size > 1 && currentLang === 'fr' ? 's' : ''}`;

        if (selectedSeenMovies.size === 0) {
          container.innerHTML = `<span class="text-[0.7rem] text-[#777777] italic py-1">${t('noSeenMoviesHint', currentLang)}</span>`;
          clearBtn.classList.add('hidden');
          return;
        }

        clearBtn.classList.remove('hidden');

        for (const title of Array.from(selectedSeenMovies).sort()) {
          const pill = document.createElement('span');
          pill.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-[#FAFADF] text-[#111111] border-2 border-[#111111] shadow-[1px_1px_0px_0px_#111111]';
          pill.innerHTML = `
            <span class="line-through opacity-85 truncate max-w-[150px]">${escapeHtml(title)}</span>
            <button type="button" class="cursor-pointer text-[#E8635A] hover:scale-125 transition-transform font-black" title="Réintégrer ce film">✕</button>
          `;
          const removeBtn = pill.querySelector('button')!;
          removeBtn.addEventListener('click', () => {
            selectedSeenMovies.delete(title);
            renderSeenMovies();
            recalculate();
          });
          container.appendChild(pill);
        }
      }

      async function onDateOrCinemaChanged() {
        const dateSelect = document.getElementById('select-date') as HTMLSelectElement;
        const selectedDate = dateSelect.value;
        if (!selectedDate) {
          currentShowtimesMap = {};
          renderPriorityMovies();
          scheduleRecalculate(0);
          return;
        }

        if (showtimesJsonCache.has(selectedDate)) {
          currentShowtimesMap = showtimesJsonCache.get(selectedDate)!;
          renderPriorityMovies();
          scheduleRecalculate(0);
          return;
        }

        try {
          const resp = await fetch(`${BASE_PATH}data/showtimes-${selectedDate}.json`);
          if (resp.ok) {
            const data = await resp.json();
            showtimesJsonCache.set(selectedDate, data);
            currentShowtimesMap = data;
          } else {
            currentShowtimesMap = {};
          }
        } catch (e) {
          currentShowtimesMap = {};
        }

        renderPriorityMovies();
        scheduleRecalculate(0);
      }

      function updatePriorityScopeUI(allCount?: number, selectedCount?: number) {
        const btnAll = document.getElementById('btn-priority-scope-all');
        const btnSelected = document.getElementById('btn-priority-scope-selected');
        if (!btnAll || !btnSelected) return;

        const allLabel = t('priorityScopeAll', currentLang);
        const selectedLabel = t('priorityScopeSelected', currentLang);

        btnAll.textContent = allCount !== undefined ? `${allLabel} (${allCount})` : allLabel;
        btnSelected.textContent = selectedCount !== undefined ? `${selectedLabel} (${selectedCount})` : selectedLabel;

        if (priorityMovieScope === 'selected') {
          btnSelected.className = 'px-2.5 py-0.5 rounded-full bg-[#FFE566] text-[#111111] border border-[#111111] font-bold cursor-pointer shadow-[1px_1px_0px_0px_#111111] transition-all';
          btnAll.className = 'px-2.5 py-0.5 rounded-full text-[#555555] hover:text-[#111111] border border-transparent font-bold cursor-pointer transition-all';
        } else {
          btnAll.className = 'px-2.5 py-0.5 rounded-full bg-[#FFE566] text-[#111111] border border-[#111111] font-bold cursor-pointer shadow-[1px_1px_0px_0px_#111111] transition-all';
          btnSelected.className = 'px-2.5 py-0.5 rounded-full text-[#555555] hover:text-[#111111] border border-transparent font-bold cursor-pointer transition-all';
        }
      }

      function renderPriorityMovies() {
        const container = document.getElementById('priority-movies-container')!;
        const countSpan = document.getElementById('priority-movies-count')!;
        const clearBtn = document.getElementById('btn-clear-priority')!;
        container.innerHTML = '';

        const cinemasById = new Map(allCinemas.map(c => [c.id, c]));
        const cityFilter = (document.getElementById('select-city') as HTMLSelectElement)?.value || 'Toutes';

        // Collect all movies for the date, filtered by city if specified
        // movieCinemasMap: movie title -> Set of cinema IDs
        const movieCinemasMap = new Map<string, Set<string>>();
        const selectedMoviesSet = new Set<string>();

        for (const [cid, stList] of Object.entries(currentShowtimesMap)) {
          const cin = cinemasById.get(cid);
          // If a specific city is selected, only consider showtimes from that city
          if (cityFilter !== 'Toutes' && cin && cin.city !== cityFilter) {
            continue;
          }
          const isCinemaSelected = selectedCinemaIds.has(cid);
          for (const st of stList) {
            if (st && st.title) {
              if (!movieCinemasMap.has(st.title)) {
                movieCinemasMap.set(st.title, new Set());
              }
              movieCinemasMap.get(st.title)!.add(cid);

              if (isCinemaSelected) {
                selectedMoviesSet.add(st.title);
              }
            }
          }
        }

        const allDayTitles = Array.from(movieCinemasMap.keys());
        const selectedCinemaTitles = Array.from(selectedMoviesSet);

        // Update scope counts and active tab UI
        updatePriorityScopeUI(allDayTitles.length, selectedCinemaTitles.length);

        const titlesToShow = priorityMovieScope === 'selected' ? selectedCinemaTitles : allDayTitles;

        // Put movies playing in checked cinemas first, then alphabetical
        titlesToShow.sort((a, b) => {
          const aInChecked = Array.from(movieCinemasMap.get(a) || []).some(cid => selectedCinemaIds.has(cid)) ? 1 : 0;
          const bInChecked = Array.from(movieCinemasMap.get(b) || []).some(cid => selectedCinemaIds.has(cid)) ? 1 : 0;
          if (aInChecked !== bInChecked) return bInChecked - aInChecked;
          return a.localeCompare(b);
        });

        countSpan.textContent = `${selectedPriorityMovies.size} ${t('selectedCinemasCount', currentLang)}${selectedPriorityMovies.size > 1 && currentLang === 'fr' ? 's' : ''}`;
        if (selectedPriorityMovies.size > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }

        if (titlesToShow.length === 0) {
          container.innerHTML = `<span class="text-[#777777] text-xs font-mono py-3 text-center w-full">${t('noPriorityFound', currentLang)}</span>`;
          return;
        }

        const frag = document.createDocumentFragment();

        for (const title of titlesToShow) {
          const isSelected = selectedPriorityMovies.has(title);
          const isSeen = selectedSeenMovies.has(title);
          const cids = movieCinemasMap.get(title) || new Set<string>();
          const isPlayingInCheckedCinema = Array.from(cids).some(cid => selectedCinemaIds.has(cid));

          const cinemaNames = Array.from(cids).map(cid => cinemasById.get(cid)?.name || cid);
          const cinemasTooltip = cinemaNames.join(', ');

          const btn = document.createElement('button');
          btn.type = 'button';
          btn.setAttribute('data-movie-title', title);
          btn.setAttribute('data-clean-title', normalizeText(title));
          btn.setAttribute('data-in-selected', isPlayingInCheckedCinema ? 'true' : 'false');
          btn.title = isPlayingInCheckedCinema
            ? `${title} (${cinemasTooltip})`
            : `${title} - ${cinemasTooltip} (${currentLang === 'en' ? 'click to add cinema & prioritize' : 'cliquer pour ajouter ce cinéma et prioriser'})`;

          let btnColorClass = 'bg-white text-[#111111] shadow-[1px_1px_0px_0px_#111111] hover:bg-[#FAFADF]';
          if (isSelected) {
            btnColorClass = 'bg-[#FFE566] text-[#111111] shadow-[2px_2px_0px_0px_#111111]';
          } else if (isSeen) {
            btnColorClass = 'bg-gray-100 text-[#888888] line-through border-gray-400 opacity-60';
          } else if (!isPlayingInCheckedCinema) {
            btnColorClass = 'bg-[#FAFADF] text-[#333333] border-dashed border-[#111111] hover:bg-[#FFE566]/50 shadow-[1px_1px_0px_0px_#111111]';
          }

          btn.className = `inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold border-2 border-[#111111] transition-all cursor-pointer ${btnColorClass}`;

          const ratings = movieRatingsMap[title];
          const ratingBadgeHtml = ratings ? renderAllocineRatingsBadge(ratings.user_rating, ratings.press_rating, true) : '';
          const starIcon = isSelected ? iconStar4('w-3 h-3 text-[#111111] shrink-0') : '';

          let cinemaBadgeHtml = '';
          if (!isPlayingInCheckedCinema && cinemaNames.length > 0) {
            const shortCinName = cinemaNames[0].replace(/^Pathé\s+/i, '');
            cinemaBadgeHtml = `<span class="text-[0.62rem] font-mono px-1 rounded bg-[#E8635A]/15 text-[#111111] border border-[#111111]/30 shrink-0">+ ${escapeHtml(shortCinName)}</span>`;
          }

          const buildBtnHtml = `
            <span
              class="btn-build-from-pill ml-0.5 p-0.5 rounded hover:bg-black/10 transition-colors shrink-0 inline-flex items-center"
              data-movie-title="${escapeHtml(title)}"
              title="Bâtir un marathon autour de ce film"
            >
              ${iconWrench('w-3.5 h-3.5 text-[#111111]')}
            </span>
          `;

          btn.innerHTML = `${starIcon}<span class="truncate max-w-[150px] font-sans">${escapeHtml(title)}</span>${ratingBadgeHtml}${cinemaBadgeHtml}${buildBtnHtml}`;

          btn.addEventListener('click', (ev) => {
            const buildTarget = (ev.target as HTMLElement).closest('.btn-build-from-pill');
            if (buildTarget) {
              ev.stopPropagation();
              startBuilderWithMovie(title);
              return;
            }

            if (selectedPriorityMovies.has(title)) {
              selectedPriorityMovies.delete(title);
            } else {
              selectedPriorityMovies.add(title);
              selectedSeenMovies.delete(title);
              renderSeenMovies();

              // If movie is not playing in any checked cinema, automatically add its cinema(s) to selectedCinemaIds
              if (!isPlayingInCheckedCinema && cids.size > 0) {
                for (const cid of cids) {
                  selectedCinemaIds.add(cid);
                }
                updateSelectedCinemasCount();
                renderSelectedCinemasChips();
                renderCinemasList();
              }
            }
            renderPriorityMovies();
            scheduleRecalculate(0);
          });
          frag.appendChild(btn);
        }

        container.appendChild(frag);
        filterPriorityMoviesInPlace();
      }

      function filterPriorityMoviesInPlace() {
        const container = document.getElementById('priority-movies-container')!;
        const cleanFilter = normalizeText(prioritySearchFilter);
        const buttons = container.querySelectorAll<HTMLButtonElement>('button[data-clean-title]');
        let matched = 0;
        buttons.forEach((b) => {
          const t = b.getAttribute('data-clean-title') || '';
          const isMatch = !cleanFilter || t.includes(cleanFilter);
          b.classList.toggle('hidden', !isMatch);
          if (isMatch) matched++;
        });

        const emptyMsgId = 'priority-filter-empty-msg';
        let emptyMsg = document.getElementById(emptyMsgId);
        if (buttons.length > 0 && matched === 0) {
          if (!emptyMsg) {
            emptyMsg = document.createElement('div');
            emptyMsg.id = emptyMsgId;
            emptyMsg.className = 'w-full py-3 text-center flex flex-col items-center gap-2';

            if (priorityMovieScope === 'selected') {
              emptyMsg.innerHTML = `
                <span class="text-[#777777] text-xs font-mono">${t('priorityOtherCinemasHint', currentLang)}</span>
                <button type="button" id="btn-quick-switch-all-scope" class="px-3 py-1 rounded-full text-xs font-bold bg-[#FFE566] text-[#111111] border-2 border-[#111111] shadow-[2px_2px_0px_0px_#111111] cursor-pointer hover:bg-[#FAFADF]">
                  ${currentLang === 'en' ? 'Search in all movies today' : 'Rechercher dans tous les films du jour'}
                </button>
              `;
              emptyMsg.querySelector('#btn-quick-switch-all-scope')?.addEventListener('click', () => {
                priorityMovieScope = 'all_day';
                renderPriorityMovies();
              });
            } else {
              emptyMsg.innerHTML = `<span class="text-[#777777] text-xs font-mono py-1">${t('noPriorityFound', currentLang)}</span>`;
            }
            container.appendChild(emptyMsg);
          }
        } else if (emptyMsg) {
          emptyMsg.remove();
        }
      }

      function openPosterModal(posterUrl: string, title: string) {
        if (!posterUrl) return;
        const modal = document.getElementById('poster-modal')!;
        const img = document.getElementById('modal-poster-img') as HTMLImageElement;
        const titleEl = document.getElementById('modal-poster-title')!;
        img.src = posterUrl;
        titleEl.textContent = title;
        modal.classList.remove('hidden');
      }

      function closePosterModal() {
        const modal = document.getElementById('poster-modal')!;
        modal.classList.add('hidden');
      }

      function selectActivePlan(idx: number) {
        if (!calculatedPlans || calculatedPlans.length === 0) return;
        if (idx < 0 || idx >= calculatedPlans.length) return;
        activePlanIndex = idx;

        const passFormula = (document.querySelector('input[name="pass-type"]:checked') as HTMLInputElement)?.value || 'Gold';
        const passTypeEnum = passFormula === 'Gold' ? PassType.GOLD : (passFormula === 'Silver' ? PassType.SILVER : PassType.UNDER26);

        // Update card styles and stamps without rebuilding DOM
        const cards = document.querySelectorAll<HTMLElement>('#results-container [data-plan-index]');
        cards.forEach((card, i) => {
          const isSelected = i === activePlanIndex;
          card.className = isSelected ? ACTIVE_CARD_CLASS : INACTIVE_CARD_CLASS;

          const stampContainer = card.querySelector('.selection-stamp-container');
          if (stampContainer) {
            stampContainer.innerHTML = getSelectionStampHtml(isSelected, currentLang);
          }

          const activeBadge = card.querySelector('.active-badge');
          if (activeBadge) {
            activeBadge.classList.toggle('hidden', !isSelected);
          }
        });

        // Update receipt
        const receiptContainer = document.getElementById('thermal-receipt-container')!;
        const currentActivePlan = calculatedPlans[activePlanIndex] || calculatedPlans[0];
        receiptContainer.innerHTML = formatThermalReceiptHtml(currentActivePlan, passTypeEnum, currentLang);

        // Re-attach ICS download
        const exportBtn = document.getElementById('btn-export-ics');
        if (exportBtn && currentActivePlan) {
          exportBtn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            downloadIcsCalendar(currentActivePlan);
          });
        }
      }

      function recalculate() {
        schedulePersistPreferences(250);

        const dateSelect = document.getElementById('select-date') as HTMLSelectElement;
        const selectedDate = dateSelect.value;
        const resultsContainer = document.getElementById('results-container')!;
        const resultsHeader = document.getElementById('results-header')!;
        const receiptContainer = document.getElementById('thermal-receipt-container')!;

        const passFormula = (document.querySelector('input[name="pass-type"]:checked') as HTMLInputElement)?.value || 'Gold';
        const passTypeEnum = passFormula === 'Gold' ? PassType.GOLD : (passFormula === 'Silver' ? PassType.SILVER : PassType.UNDER26);

        if (selectedCinemaIds.size === 0) {
          resultsHeader.innerHTML = '';
          resultsContainer.innerHTML = `
            <div class="neo-card p-8 text-center text-[#555555] space-y-2">
              <div class="w-10 h-10 mx-auto rounded-full bg-[#FAFADF] border-2 border-[#111111] flex items-center justify-center">
                ${iconBuilding('w-5 h-5 text-[#111111]')}
              </div>
              <p class="font-bold text-xs text-[#111111]">${t('noCinemaSelectedAdvice', currentLang)}</p>
            </div>
          `;
          receiptContainer.innerHTML = formatThermalReceiptHtml(null, passTypeEnum, currentLang);
          return;
        }

        if (!selectedDate) {
          resultsHeader.innerHTML = '';
          resultsContainer.innerHTML = `
            <div class="neo-card p-8 text-center text-[#555555]">
              ${t('noShowtimesDateTitle', currentLang)}
            </div>
          `;
          receiptContainer.innerHTML = formatThermalReceiptHtml(null, passTypeEnum, currentLang);
          return;
        }

        const todayStr = new Date().toISOString().slice(0, 10);
        let warningBanner = '';
        if (selectedDate < todayStr) {
          warningBanner = `
            <div class="neo-card bg-[#FFE566] p-3.5 mb-4 text-xs font-bold text-[#111111] flex items-center gap-3">
              <span class="p-1 rounded-[4px] bg-white border border-[#111111] shrink-0">
                ${iconAlert('w-4 h-4 text-[#111111]')}
              </span>
              <div>
                <strong>${currentLang === 'en' ? 'Notice:' : 'Attention :'}</strong> ${currentLang === 'en' ? 'The selected date' : 'La date sélectionnée'} (<strong>${selectedDate}</strong>) ${currentLang === 'en' ? 'has already passed.' : 'est déjà passée.'}
              </div>
            </div>
          `;
        }

        const candidateShowtimes = getAllAvailableShowtimes();

        if (candidateShowtimes.length === 0) {
          resultsHeader.innerHTML = '';
          resultsContainer.innerHTML = `
            ${warningBanner}
            <div class="neo-card bg-[#F9A8B8] p-6 text-center text-xs font-bold text-[#111111] flex flex-col items-center gap-2">
              ${iconAlert('w-5 h-5 text-[#111111]')}
              <span>${t('noShowtimesDateTitle', currentLang)} (${selectedDate}).</span>
            </div>
          `;
          receiptContainer.innerHTML = formatThermalReceiptHtml(null, passTypeEnum, currentLang);
          return;
        }

        const criteria = getCurrentCriteria();

        let plans = scheduler.generatePlans(candidateShowtimes, criteria);

        if (activeScenario === 'same_cinema') {
          plans.sort((a, b) => {
            if (Boolean(a.is_favorite_pick) !== Boolean(b.is_favorite_pick)) {
              return a.is_favorite_pick ? 1 : -1;
            }
            const cinSetA = new Set(a.showtimes.map(s => s.cinema_id)).size;
            const cinSetB = new Set(b.showtimes.map(s => s.cinema_id)).size;
            if (cinSetA !== cinSetB) return cinSetA - cinSetB;
            return b.score - a.score;
          });
        } else if (activeScenario === 'short_breaks') {
          plans.sort((a, b) => {
            if (Boolean(a.is_favorite_pick) !== Boolean(b.is_favorite_pick)) {
              return a.is_favorite_pick ? 1 : -1;
            }
            if (a.total_pause_minutes !== b.total_pause_minutes) {
              return a.total_pause_minutes - b.total_pause_minutes;
            }
            return b.score - a.score;
          });
        } else {
          plans.sort((a, b) => {
            if (Boolean(a.is_favorite_pick) !== Boolean(b.is_favorite_pick)) {
              return a.is_favorite_pick ? 1 : -1;
            }
            return b.score - a.score;
          });
        }

        calculatedPlans = plans;

        if (plans.length === 0) {
          resultsHeader.innerHTML = '';
          resultsContainer.innerHTML = `
            ${warningBanner}
            <div class="neo-card bg-[#F9A8B8] p-6 text-center text-xs text-[#111111] leading-relaxed font-bold space-y-2">
              <div class="w-8 h-8 mx-auto rounded-full bg-white border border-[#111111] flex items-center justify-center">
                ${iconAlert('w-4 h-4 text-[#111111]')}
              </div>
              <p>${t('noPlansTitle', currentLang)}</p>
              <p class="font-normal text-[0.7rem] text-[#333333]">${t('noPlansAdvice', currentLang)}</p>
            </div>
          `;
          receiptContainer.innerHTML = formatThermalReceiptHtml(null, passTypeEnum, currentLang);
          return;
        }

        if (activePlanIndex >= plans.length) {
          activePlanIndex = 0;
        }

        const cinCountInfo = selectedCinemaIds.size > 1
          ? t('proposalsInCinemas', currentLang, { n: selectedCinemaIds.size })
          : t('proposalsInOneCinema', currentLang);

        const standardPlans = plans.filter((p) => !p.is_favorite_pick);
        const favoritePlan = plans.find((p) => p.is_favorite_pick);

        const proposalsFoundText = favoritePlan && standardPlans.length > 0
          ? t('proposalsFoundWithFavorite', currentLang, {
              n: standardPlans.length,
              s: standardPlans.length > 1 ? 's' : '',
            })
          : t('proposalsFound', currentLang, {
              n: plans.length,
              s: plans.length > 1 ? 's' : '',
            });

        resultsHeader.innerHTML = `<span class="inline-flex items-center gap-1.5">${iconSparkles('w-4 h-4 text-[#111111]')}<strong>${proposalsFoundText}</strong> ${cinCountInfo} !</span>`;

        let cardsHtml = standardPlans.map((p, idx) =>
          formatItineraryCardHtml(p, idx + 1, passTypeEnum, idx === activePlanIndex, currentLang)
        ).join('');

        if (favoritePlan) {
          const favIndex = plans.indexOf(favoritePlan);
          const isFavSelected = favIndex === activePlanIndex;
          const favCardHtml = formatItineraryCardHtml(favoritePlan, favIndex + 1, passTypeEnum, isFavSelected, currentLang);

          cardsHtml += `
            <div class="pt-5 mt-6 border-t-2 border-dashed border-[#111111] space-y-3">
              <div class="flex items-center justify-between gap-2 flex-wrap bg-[#FAFADF] border-2 border-[#111111] p-3 rounded-[10px] shadow-[2px_2px_0px_0px_#111111]">
                <div class="flex items-center gap-2">
                  <span class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-[#FFE566] border-2 border-[#111111] font-mono font-black text-xs shadow-[1px_1px_0px_0px_#111111]">
                    ★
                  </span>
                  <h3 class="text-xs sm:text-sm font-black text-[#111111] font-sans lowercase">
                    ${t('favoriteMarathonSectionTitle', currentLang)}
                  </h3>
                </div>
                <span class="text-[0.65rem] font-mono font-black text-[#111111] bg-white border border-[#111111] px-2.5 py-0.5 rounded-full shadow-[1px_1px_0px_0px_#111111] uppercase tracking-wider">
                  ${t('favoriteMarathonSectionBadge', currentLang)}
                </span>
              </div>
              ${favCardHtml}
            </div>
          `;
        }

        resultsContainer.innerHTML = warningBanner + cardsHtml;

        if (builderModeActive) {
          renderBuilderPanel();
          renderBuilderThermalReceipt();
        } else {
          const currentActivePlan = plans[activePlanIndex] || plans[0];
          receiptContainer.innerHTML = formatThermalReceiptHtml(currentActivePlan, passTypeEnum, currentLang);
        }

        // Click to select active marathon card
        document.querySelectorAll('#results-container [data-plan-index]').forEach(card => {
          card.addEventListener('click', (ev) => {
            const target = ev.target as HTMLElement;
            if (target.closest('.poster-thumb') || target.closest('.btn-mark-seen') || target.closest('.btn-build-around')) {
              return;
            }
            const idx = parseInt(card.getAttribute('data-plan-index') || '1', 10) - 1;
            selectActivePlan(idx);
          });
        });

        // Click on Composer button on showtimes
        document.querySelectorAll('#results-container .btn-build-around').forEach(btn => {
          btn.addEventListener('click', (ev) => {
            ev.preventDefault();
            ev.stopPropagation();
            const el = btn as HTMLElement;
            const title = el.getAttribute('data-movie-title') || '';
            const cid = el.getAttribute('data-cinema-id') || undefined;
            const starts = el.getAttribute('data-starts-at') || undefined;
            startBuilderWithMovie(title, cid, starts);
          });
        });

        // Click on poster thumbnail to open modal
        document.querySelectorAll('.poster-thumb').forEach(thumb => {
          thumb.addEventListener('click', (ev) => {
            ev.stopPropagation();
            const posterUrl = thumb.getAttribute('data-poster-preview') || '';
            const title = thumb.getAttribute('data-poster-title') || '';
            openPosterModal(posterUrl, title);
          });
        });

        // Click on "déjà vu ?" button to exclude movie
        document.querySelectorAll('.btn-mark-seen').forEach(btn => {
          btn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            const movieTitle = btn.getAttribute('data-movie-title');
            if (movieTitle) {
              selectedSeenMovies.add(movieTitle);
              selectedPriorityMovies.delete(movieTitle);
              renderSeenMovies();
              renderPriorityMovies();
              scheduleRecalculate(0);
            }
          });
        });

        // ICS export listener
        const exportBtn = document.getElementById('btn-export-ics');
        if (exportBtn && currentActivePlan) {
          exportBtn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            downloadIcsCalendar(currentActivePlan);
          });
        }
      }

      function downloadIcsCalendar(itinerary: Itinerary) {
        if (!itinerary || !itinerary.showtimes || itinerary.showtimes.length === 0) return;

        const formatIcsDate = (isoStr: string) => {
          return isoStr.replace(/[-:]/g, '').split('.')[0] + 'Z';
        };

        const nowIcs = formatIcsDate(new Date().toISOString());
        let icsEvents = '';

        itinerary.showtimes.forEach((st, i) => {
          const dtStart = formatIcsDate(new Date(st.starts_at).toISOString());
          const dtEnd = formatIcsDate(new Date(st.ends_at).toISOString());
          const uid = `cinepass-${Date.now()}-${i}@cinepass.planner`;

          icsEvents += `
BEGIN:VEVENT
UID:${uid}
DTSTAMP:${nowIcs}
DTSTART:${dtStart}
DTEND:${dtEnd}
SUMMARY:CinéPass : ${st.movie_title} (${st.format || 'Standard'})
LOCATION:${st.cinema_name || 'Cinéma'}
DESCRIPTION:Séance n°${i + 1} de votre marathon cinépass. Version: ${st.version || 'VF/VOST'}.
STATUS:CONFIRMED
END:VEVENT`;
        });

        const icsContent = `BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//CinePass Planner//FR
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:Marathon CinéPass
X-WR-TIMEZONE:Europe/Paris${icsEvents}
END:VCALENDAR`.trim();

        const blob = new Blob([icsContent], { type: 'text/calendar;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        const dateStr = itinerary.showtimes[0]?.date_str || 'seance';
        link.setAttribute('download', `marathon-cinepass-${dateStr}.ics`);
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
      }

      function persistCurrentPreferences() {
        const city = (document.getElementById('select-city') as HTMLSelectElement)?.value;
        const passFormula = (document.querySelector('input[name="pass-type"]:checked') as HTMLInputElement)?.value;
        const allowSupplements = (document.getElementById('check-supplements') as HTMLInputElement)?.checked;
        const lang = (document.querySelector('input[name="lang-filter"]:checked') as HTMLInputElement)?.value;
        const targetCount = parseInt((document.getElementById('range-count') as HTMLInputElement)?.value, 10);
        const startTime = (document.getElementById('input-start') as HTMLInputElement)?.value;
        const endTime = (document.getElementById('input-end') as HTMLInputElement)?.value;
        const requireMeal = (document.getElementById('check-meal') as HTMLInputElement)?.checked;
        const minBuffer = parseInt((document.getElementById('input-buffer') as HTMLInputElement)?.value, 10);

        const checkedFormats: string[] = [];
        document.querySelectorAll('.format-check:checked').forEach((cb: any) => {
          checkedFormats.push(cb.value);
        });

        savePreferences({
          city,
          selected_cinemas: Array.from(selectedCinemaIds),
          pass_formula: passFormula,
          allow_supplements: allowSupplements,
          language: lang,
          selected_formats: checkedFormats,
          target_count: targetCount,
          start_time: startTime,
          end_time: endTime,
          require_meal: requireMeal,
          min_buffer: minBuffer,
          scenario: activeScenario,
          seen_movies: Array.from(selectedSeenMovies),
          priority_movies: Array.from(selectedPriorityMovies),
        });

        try {
          const params = new URLSearchParams();
          if (city && city !== 'Toutes') params.set('city', city);
          if (passFormula) params.set('pass', passFormula);
          if (lang && lang !== 'ALL') params.set('lang', lang);
          if (targetCount) params.set('count', String(targetCount));
          const searchStr = params.toString() ? `?${params.toString()}` : '';
          if (window.location.search !== searchStr) {
            const newUrl = searchStr || window.location.pathname;
            window.history.replaceState({}, '', newUrl);
          }
        } catch (e) {
          // ignore
        }
      }

      function getCurrentCriteria(): PlanCriteria {
        const dateSelect = document.getElementById('select-date') as HTMLSelectElement;
        const selectedDate = dateSelect?.value || '';
        const allowSupplements = (document.getElementById('check-supplements') as HTMLInputElement)?.checked ?? false;
        const langFilter = (document.querySelector('input[name="lang-filter"]:checked') as HTMLInputElement)?.value || 'ALL';
        const targetCount = parseInt((document.getElementById('range-count') as HTMLInputElement)?.value, 10) || 3;
        const startTime = (document.getElementById('input-start') as HTMLInputElement)?.value || '10:00';
        const endTime = (document.getElementById('input-end') as HTMLInputElement)?.value || '23:00';
        const requireMeal = (document.getElementById('check-meal') as HTMLInputElement)?.checked ?? false;
        const minBuffer = parseInt((document.getElementById('input-buffer') as HTMLInputElement)?.value, 10) || 15;

        const checkedFormats: string[] = [];
        document.querySelectorAll('.format-check:checked').forEach((cb: any) => {
          checkedFormats.push(cb.value);
        });

        const passFormula = (document.querySelector('input[name="pass-type"]:checked') as HTMLInputElement)?.value || 'Gold';
        const passTypeEnum = passFormula === 'Gold' ? PassType.GOLD : (passFormula === 'Silver' ? PassType.SILVER : PassType.UNDER26);

        return {
          cinema_ids: Array.from(selectedCinemaIds),
          date_str: selectedDate,
          target_films_count: targetCount,
          start_time: startTime,
          max_end_time: endTime,
          priority_movies: Array.from(selectedPriorityMovies),
          seen_movies: Array.from(selectedSeenMovies),
          pass_type: passTypeEnum,
          allow_supplements: allowSupplements,
          min_buffer_minutes: minBuffer,
          require_meal_break: requireMeal,
          language: langFilter,
          selected_formats: checkedFormats,
        };
      }

      function getAllAvailableShowtimes(): Showtime[] {
        const dateSelect = document.getElementById('select-date') as HTMLSelectElement;
        const selectedDate = dateSelect?.value || '';
        const candidateShowtimes: Showtime[] = [];
        const cinemasById = new Map(allCinemas.map(c => [c.id, c.name]));
        const seenShowtimes = new Set<string>();

        for (const cid of selectedCinemaIds) {
          const rawList = currentShowtimesMap[cid] || [];
          const cinName = cinemasById.get(cid) || cid;
          const isKnownPremium = cid === 'G02BG' || cid === 'C0158' || cinName.toLowerCase().includes('palace') || cinName.toLowerCase().includes('parnasse');
          for (const raw of rawList) {
            const ratings = movieRatingsMap[raw.title];
            let fmt = raw.format || 'Standard';
            if (fmt === 'Standard' && isKnownPremium) {
              fmt = 'Premium';
            }
            const dedupKey = `${cid}|${raw.title}|${raw.starts_at}|${raw.version || 'ORIGINAL'}|${fmt}`;
            if (seenShowtimes.has(dedupKey)) continue;
            seenShowtimes.add(dedupKey);

            candidateShowtimes.push({
              cinema_id: cid,
              movie_title: raw.title,
              starts_at: raw.starts_at,
              ends_at: raw.ends_at,
              date_str: selectedDate,
              version: raw.version || 'ORIGINAL',
              format: fmt,
              cinema_name: cinName,
              poster_url: raw.poster_url || '',
              user_rating: ratings ? ratings.user_rating : null,
              press_rating: ratings ? ratings.press_rating : null,
            });
          }
        }
        return candidateShowtimes;
      }

      function startBuilderWithMovie(title: string, cinemaId?: string, startsAt?: string) {
        if (cinemaId && !selectedCinemaIds.has(cinemaId)) {
          selectedCinemaIds.add(cinemaId);
          updateSelectedCinemasCount();
          renderSelectedCinemasChips();
          renderCinemasList();
        }

        let candidates = getAllAvailableShowtimes();
        let chosenShowtime = candidates.find(s => {
          if (s.movie_title !== title) return false;
          if (cinemaId && s.cinema_id !== cinemaId) return false;
          if (startsAt && s.starts_at !== startsAt) return false;
          return true;
        });

        if (!chosenShowtime) {
          const dateSelect = document.getElementById('select-date') as HTMLSelectElement;
          const selectedDate = dateSelect?.value || '';
          const cinemasById = new Map(allCinemas.map(c => [c.id, c.name]));

          for (const [cid, rawList] of Object.entries(currentShowtimesMap)) {
            for (const raw of rawList) {
              if (raw.title === title && (!startsAt || raw.starts_at === startsAt) && (!cinemaId || cid === cinemaId)) {
                selectedCinemaIds.add(cid);
                updateSelectedCinemasCount();
                renderSelectedCinemasChips();
                renderCinemasList();
                const cinName = cinemasById.get(cid) || cid;
                const isKnownPremium = cid === 'G02BG' || cid === 'C0158' || cinName.toLowerCase().includes('palace') || cinName.toLowerCase().includes('parnasse');
                let fmt = raw.format || 'Standard';
                if (fmt === 'Standard' && isKnownPremium) {
                  fmt = 'Premium';
                }
                const ratings = movieRatingsMap[raw.title];
                chosenShowtime = {
                  cinema_id: cid,
                  movie_title: raw.title,
                  starts_at: raw.starts_at,
                  ends_at: raw.ends_at,
                  date_str: selectedDate,
                  version: raw.version || 'ORIGINAL',
                  format: fmt,
                  cinema_name: cinName,
                  poster_url: raw.poster_url || '',
                  user_rating: ratings ? ratings.user_rating : null,
                  press_rating: ratings ? ratings.press_rating : null,
                };
                break;
              }
            }
            if (chosenShowtime) break;
          }
        }

        if (!chosenShowtime) {
          openStartMovieDrawer();
          return;
        }

        const target = Math.max(1, getTargetCount());
        builderSlots = new Array(target).fill(null);
        builderSlots[0] = chosenShowtime;
        builderPinnedIndex = 0;
        builderModeActive = true;
        lastBuilderPinnedSignature = '';
        builderProposalCycleIndex = 0;
        cachedBuilderProposals = [];

        recomputeBuilderProposals(false);
        renderBuilderPanel();
        renderBuilderThermalReceipt();

        const panel = document.getElementById('builder-panel');
        if (panel) {
          panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }

      function recomputeBuilderProposals(cycle: boolean = false) {
        syncBuilderSlotsLength();

        let pinnedShowtime = builderSlots[builderPinnedIndex];
        if (!pinnedShowtime) {
          const firstFilled = builderSlots.findIndex(s => s !== null);
          if (firstFilled !== -1) {
            builderPinnedIndex = firstFilled;
            pinnedShowtime = builderSlots[builderPinnedIndex];
          } else {
            openStartMovieDrawer();
            return;
          }
        }

        const candidateShowtimes = getAllAvailableShowtimes();
        const criteria = getCurrentCriteria();
        const pinnedSig = `${pinnedShowtime.movie_title}@${pinnedShowtime.cinema_id}@${pinnedShowtime.starts_at}#pos=${builderPinnedIndex}#len=${builderSlots.length}`;

        if (pinnedSig !== lastBuilderPinnedSignature || cachedBuilderProposals.length === 0) {
          lastBuilderPinnedSignature = pinnedSig;
          cachedBuilderProposals = scheduler.findMarathonsAroundPinned(
            candidateShowtimes,
            {
              pinnedShowtime,
              pinnedIndex: builderPinnedIndex,
              targetCount: builderSlots.length,
              criteria,
            }
          );
          builderProposalCycleIndex = 0;
        } else if (cycle) {
          if (cachedBuilderProposals.length > 1) {
            builderProposalCycleIndex = (builderProposalCycleIndex + 1) % cachedBuilderProposals.length;
          }
        }

        const subtitleEl = document.getElementById('builder-panel-subtitle');

        if (cachedBuilderProposals.length > 0) {
          const chosenPlan = cachedBuilderProposals[builderProposalCycleIndex];
          for (let i = 0; i < builderSlots.length; i++) {
            if (i === builderPinnedIndex) {
              builderSlots[i] = pinnedShowtime;
            } else {
              builderSlots[i] = chosenPlan.showtimes[i] || null;
            }
          }

          if (subtitleEl) {
            if (cachedBuilderProposals.length === 1) {
              subtitleEl.textContent = t('builderSubOneProposal', currentLang);
            } else {
              subtitleEl.textContent = t('builderSubProposalCycle', currentLang, {
                idx: builderProposalCycleIndex + 1,
                total: cachedBuilderProposals.length,
              });
            }
          }
        } else {
          // Fallback: Greedy filling of empty slots if no complete chain exists
          let filledAny = false;
          const minBuffer = criteria.min_buffer_minutes || 15;
          const selectedCinemasSet = new Set(criteria.cinema_ids);

          for (let i = 0; i < builderSlots.length; i++) {
            if (builderSlots[i] === null) {
              const predecessor = i > 0 ? builderSlots[i - 1] : null;
              const successor = i < builderSlots.length - 1 ? builderSlots[i + 1] : null;
              const usedTitles = new Set(
                builderSlots
                  .filter((s): s is Showtime => s !== null)
                  .map(s => s.movie_title)
              );

              const available = scheduler.getAvailableCandidatesForSlot(candidateShowtimes, {
                predecessor,
                successor,
                minBufferMinutes: minBuffer,
                selectedCinemas: selectedCinemasSet,
                excludedTitles: usedTitles,
              });

              if (available.length > 0) {
                const qualifiesForPremium = criteria.pass_type === PassType.GOLD || criteria.allow_supplements;
                available.sort((a, b) => {
                  const premA = qualifiesForPremium && isPremiumFormat(a.showtime.format) ? 1 : 0;
                  const premB = qualifiesForPremium && isPremiumFormat(b.showtime.format) ? 1 : 0;
                  if (premB !== premA) return premB - premA;

                  const ratingA = (a.showtime.user_rating || 0) + (a.showtime.press_rating || 0);
                  const ratingB = (b.showtime.user_rating || 0) + (b.showtime.press_rating || 0);
                  if (ratingB !== ratingA) return ratingB - ratingA;

                  return a.gapBeforeMinutes - b.gapBeforeMinutes;
                });
                builderSlots[i] = available[0].showtime;
                filledAny = true;
              }
            }
          }

          if (subtitleEl) {
            if (filledAny) {
              subtitleEl.textContent = t('builderSubGreedyFilled', currentLang);
            } else {
              subtitleEl.textContent = t('builderSubNoProposals', currentLang);
            }
          }
        }
      }

      function shiftPinnedSlot(newIndex: number) {
        syncBuilderSlotsLength();
        if (newIndex < 0 || newIndex >= builderSlots.length || newIndex === builderPinnedIndex) return;

        const currentPinned = builderSlots[builderPinnedIndex];
        if (!currentPinned) return;

        builderPinnedIndex = newIndex;
        lastBuilderPinnedSignature = '';
        recomputeBuilderProposals(false);
        renderBuilderPanel();
        renderBuilderThermalReceipt();
      }

      function openStartMovieDrawer() {
        drawerMode = 'choose_start_movie';
        drawerTargetSlot = 0;
        drawerFilterText = '';

        const titleEl = document.getElementById('builder-drawer-title');
        const subtitleEl = document.getElementById('builder-drawer-subtitle');
        const filterInput = document.getElementById('input-drawer-filter') as HTMLInputElement;
        const backdrop = document.getElementById('builder-drawer-backdrop');

        if (titleEl) titleEl.textContent = t('builderDrawerStartTitle', currentLang);
        if (subtitleEl) subtitleEl.textContent = t('builderDrawerStartSubtitle', currentLang);
        if (filterInput) filterInput.value = '';

        renderStartMovieDrawerList();

        backdrop?.classList.remove('hidden');
      }

      function renderStartMovieDrawerList() {
        const container = document.getElementById('builder-drawer-list');
        if (!container) return;

        const dateSelect = document.getElementById('select-date') as HTMLSelectElement;
        const selectedDate = dateSelect?.value || '';
        const cinemasById = new Map(allCinemas.map(c => [c.id, c.name]));

        const sourceCinemas = selectedCinemaIds.size > 0 ? Array.from(selectedCinemaIds) : Object.keys(currentShowtimesMap);
        const moviesMap = new Map<string, { movie_title: string; showtimes: Showtime[]; poster_url?: string }>();
        const seenInStartDrawer = new Set<string>();

        for (const cid of sourceCinemas) {
          const rawList = currentShowtimesMap[cid] || [];
          const cinName = cinemasById.get(cid) || cid;
          for (const raw of rawList) {
            const dedupKey = `${cid}|${raw.title}|${raw.starts_at}|${raw.version || 'ORIGINAL'}|${raw.format || 'Standard'}`;
            if (seenInStartDrawer.has(dedupKey)) continue;
            seenInStartDrawer.add(dedupKey);

            if (!moviesMap.has(raw.title)) {
              moviesMap.set(raw.title, { movie_title: raw.title, showtimes: [], poster_url: raw.poster_url });
            }
            const ratings = movieRatingsMap[raw.title];
            moviesMap.get(raw.title)!.showtimes.push({
              cinema_id: cid,
              movie_title: raw.title,
              starts_at: raw.starts_at,
              ends_at: raw.ends_at,
              date_str: selectedDate,
              version: raw.version || 'ORIGINAL',
              format: raw.format || 'Standard',
              cinema_name: cinName,
              poster_url: raw.poster_url || '',
              user_rating: ratings ? ratings.user_rating : null,
              press_rating: ratings ? ratings.press_rating : null,
            });
          }
        }

        const cleanFilter = normalizeText(drawerFilterText);
        let sortedTitles = Array.from(moviesMap.keys());

        if (cleanFilter) {
          sortedTitles = sortedTitles.filter(t => normalizeText(t).includes(cleanFilter));
        }

        sortedTitles.sort((a, b) => {
          const aPrio = selectedPriorityMovies.has(a);
          const bPrio = selectedPriorityMovies.has(b);
          if (aPrio && !bPrio) return -1;
          if (!aPrio && bPrio) return 1;
          return a.localeCompare(b);
        });

        if (sortedTitles.length === 0) {
          container.innerHTML = `
            <div class="neo-card p-6 text-center text-xs text-[#555555]">
              ${t('builderDrawerNoMovies', currentLang)}
            </div>
          `;
          return;
        }

        let html = '';
        for (const title of sortedTitles) {
          const entry = moviesMap.get(title)!;
          const isPrio = selectedPriorityMovies.has(title);
          const ratings = movieRatingsMap[title];
          const ratingBadge = renderAllocineRatingsBadge(ratings?.user_rating, ratings?.press_rating, true);

          entry.showtimes.sort((a, b) => a.starts_at.localeCompare(b.starts_at));

          const showtimesPillsHtml = entry.showtimes.slice(0, 8).map(st => {
            const sStart = st.starts_at.split('T')[1].slice(0, 5);
            return `
              <button
                type="button"
                class="btn-pick-start-showtime neo-btn text-[0.7rem] font-mono font-bold px-2 py-0.5 rounded-[4px] bg-white hover:bg-[#FFE566] text-[#111111] border border-[#111111] cursor-pointer shadow-[1px_1px_0px_0px_#111111]"
                data-title="${escapeHtml(title)}"
                data-cid="${st.cinema_id}"
                data-starts="${st.starts_at}"
              >
                ${sStart} <span class="text-[0.6rem] text-[#666666] font-sans font-normal">(${escapeHtml(st.cinema_name || '')})</span>
              </button>
            `;
          }).join('');

          const showtimeCountLabel = t('builderDrawerAvailableShowtimes', currentLang, {
            n: entry.showtimes.length,
            s: entry.showtimes.length > 1 ? 's' : '',
          });

          html += `
            <div class="neo-card p-3 bg-white border-2 border-[#111111] rounded-[10px] shadow-[2px_2px_0px_0px_#111111] flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div class="min-w-0 flex items-center gap-2.5">
                ${isPrio ? `<span class="w-2.5 h-2.5 rounded-full bg-[#FFE566] border border-[#111111] shrink-0" title="Film prioritaire"></span>` : ''}
                <div>
                  <div class="flex items-center gap-2 flex-wrap">
                    <span class="font-extrabold text-xs sm:text-sm text-[#111111] font-sans">${escapeHtml(title)}</span>
                    ${ratingBadge}
                  </div>
                  <p class="text-[0.68rem] text-[#666666] mt-0.5 font-mono">
                    ${showtimeCountLabel}
                  </p>
                </div>
              </div>
              <div class="flex items-center gap-1.5 flex-wrap shrink-0">
                ${showtimesPillsHtml}
              </div>
            </div>
          `;
        }

        container.innerHTML = html;

        container.querySelectorAll('.btn-pick-start-showtime').forEach(btn => {
          btn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            const title = btn.getAttribute('data-title') || '';
            const cid = btn.getAttribute('data-cid') || undefined;
            const starts = btn.getAttribute('data-starts') || undefined;
            closeBuilderDrawer();
            startBuilderWithMovie(title, cid, starts);
          });
        });
      }

      function openBuilderDrawer(slotIndex: number) {
        drawerMode = 'choose_slot_showtime';
        drawerTargetSlot = slotIndex;
        drawerFilterText = '';

        const titleEl = document.getElementById('builder-drawer-title');
        const subtitleEl = document.getElementById('builder-drawer-subtitle');
        const filterInput = document.getElementById('input-drawer-filter') as HTMLInputElement;
        const backdrop = document.getElementById('builder-drawer-backdrop');

        const slotNumber = slotIndex + 1;
        if (titleEl) titleEl.textContent = t('builderDrawerSlotTitle', currentLang, { slotNumber });
        if (filterInput) filterInput.value = '';

        const candidateShowtimes = getAllAvailableShowtimes();
        const criteria = getCurrentCriteria();

        const predecessor = slotIndex > 0 ? builderSlots[slotIndex - 1] : null;
        const successor = slotIndex < builderSlots.length - 1 ? builderSlots[slotIndex + 1] : null;

        const otherSlotTitles = new Set(
          builderSlots
            .filter((s, idx) => idx !== slotIndex && s !== null)
            .map(s => s!.movie_title)
        );

        drawerCandidates = scheduler.getAvailableCandidatesForSlot(
          candidateShowtimes,
          {
            predecessor,
            successor,
            minBufferMinutes: criteria.min_buffer_minutes,
            selectedCinemas: new Set(criteria.cinema_ids),
            excludedTitles: otherSlotTitles,
          }
        );

        if (subtitleEl) {
          subtitleEl.textContent = t('builderDrawerSlotSubtitle', currentLang, {
            n: drawerCandidates.length,
            s: drawerCandidates.length > 1 ? 's' : '',
          });
        }

        renderBuilderDrawerCandidates();

        backdrop?.classList.remove('hidden');
      }

      function renderBuilderDrawerCandidates() {
        const container = document.getElementById('builder-drawer-list');
        if (!container) return;

        const cleanFilter = normalizeText(drawerFilterText);
        let list = drawerCandidates;
        if (cleanFilter) {
          list = list.filter(c =>
            normalizeText(c.showtime.movie_title).includes(cleanFilter) ||
            normalizeText(c.showtime.cinema_name || '').includes(cleanFilter)
          );
        }

        if (list.length === 0) {
          container.innerHTML = `
            <div class="neo-card p-6 text-center text-xs text-[#555555] space-y-1">
              <p class="font-bold text-[#111111]">${t('builderDrawerNoShowtimesTitle', currentLang)}</p>
              <p class="text-[0.7rem] text-[#666666]">${t('builderDrawerNoShowtimesHint', currentLang)}</p>
            </div>
          `;
          return;
        }

        // Group by movie title to eliminate duplicate movie entries in the list
        const groupsMap = new Map<string, {
          title: string;
          poster_url?: string;
          is_priority: boolean;
          candidates: Array<{ candidateIndex: number; item: typeof list[0] }>;
        }>();

        for (let idx = 0; idx < list.length; idx++) {
          const item = list[idx];
          const title = item.showtime.movie_title;
          if (!groupsMap.has(title)) {
            groupsMap.set(title, {
              title,
              poster_url: item.showtime.poster_url,
              is_priority: selectedPriorityMovies.has(title),
              candidates: [],
            });
          }
          groupsMap.get(title)!.candidates.push({ candidateIndex: idx, item });
        }

        // Sort movies: priority ("coup de coeur") first, then alphabetically
        const sortedGroups = Array.from(groupsMap.values()).sort((a, b) => {
          if (a.is_priority && !b.is_priority) return -1;
          if (!a.is_priority && b.is_priority) return 1;
          return a.title.localeCompare(b.title);
        });

        let html = '';
        for (const group of sortedGroups) {
          const ratings = movieRatingsMap[group.title];
          const ratingBadge = renderAllocineRatingsBadge(ratings?.user_rating, ratings?.press_rating, true);

          const timeChipsHtml = group.candidates.map(({ candidateIndex, item }) => {
            const st = item.showtime;
            const sStart = st.starts_at.split('T')[1].slice(0, 5);
            const sEnd = st.ends_at.split('T')[1].slice(0, 5);
            const isVost = st.version && (st.version === 'VOST' || st.version === 'ORIGINAL');
            const langLabel = isVost ? 'VOST' : 'VF';
            const cinShort = st.cinema_name ? st.cinema_name.replace(/^Pathé\s+/i, '') : '';
            const fmt = st.format && st.format !== 'Standard' ? ` [${st.format}]` : '';

            let gapText = '';
            if (item.gapBeforeMinutes > 0 && drawerTargetSlot !== null && drawerTargetSlot > 0) {
              gapText = t('builderDrawerBreakChip', currentLang, { gap: item.gapBeforeMinutes });
            }

            return `
              <button
                type="button"
                class="btn-select-candidate neo-btn text-[0.7rem] font-mono font-bold px-2.5 py-1.5 rounded-[6px] bg-white hover:bg-[#FFE566] text-[#111111] border border-[#111111] shadow-[1px_1px_0px_0px_#111111] cursor-pointer transition-all flex items-center gap-1.5 flex-wrap"
                data-candidate-index="${candidateIndex}"
                title="${sStart} - ${sEnd} à ${escapeHtml(st.cinema_name || '')} (${langLabel}${fmt})"
              >
                <span class="font-black text-xs bg-[#FFE566] px-1 py-0.5 rounded border border-[#111111]">${sStart}</span>
                <span class="text-[0.68rem] text-[#555555] font-sans truncate max-w-[130px]">${escapeHtml(cinShort)}</span>
                <span class="text-[0.62rem] font-mono px-1 py-0.5 rounded border border-[#111111] ${isVost ? 'bg-[#C4B5FD]' : 'bg-[#FAFADF]'}">${langLabel}</span>
                ${fmt ? `<span class="text-[0.62rem] font-bold ${isPremiumFormat(st.format) ? 'bg-[#FFE566] text-[#111111] px-1 py-0.5 rounded border border-[#111111]' : 'text-[#E8635A]'}">${escapeHtml(fmt)}</span>` : ''}
                ${gapText ? `<span class="text-[0.6rem] font-mono text-[#555555]">${gapText}</span>` : ''}
              </button>
            `;
          }).join('');

          const compatibleCountLabel = t('builderDrawerCompatibleShowtimes', currentLang, {
            n: group.candidates.length,
            s: group.candidates.length > 1 ? 's' : '',
          });

          html += `
            <div class="neo-card p-3 sm:p-4 bg-white border-2 border-[#111111] rounded-[10px] shadow-[2px_2px_0px_0px_#111111] space-y-2">
              <div class="flex items-center justify-between gap-2 flex-wrap border-b border-[#E5E5E5] pb-2">
                <div class="flex items-center gap-2 min-w-0">
                  ${group.is_priority ? `<span class="w-2.5 h-2.5 rounded-full bg-[#FFE566] border border-[#111111] shrink-0" title="Coup de coeur"></span>` : ''}
                  <span class="font-black text-xs sm:text-sm text-[#111111] font-sans truncate">${escapeHtml(group.title)}</span>
                  ${ratingBadge}
                </div>
                <span class="text-[0.68rem] font-mono text-[#666666]">
                  ${compatibleCountLabel}
                </span>
              </div>
              <div class="flex items-center gap-2 flex-wrap pt-0.5">
                ${timeChipsHtml}
              </div>
            </div>
          `;
        }

        container.innerHTML = html;

        container.querySelectorAll('.btn-select-candidate').forEach(btn => {
          btn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            const cIdx = parseInt(btn.getAttribute('data-candidate-index') || '0', 10);
            const chosen = list[cIdx];
            if (chosen && drawerTargetSlot !== null) {
              builderSlots[drawerTargetSlot] = chosen.showtime;
              lastBuilderPinnedSignature = '';
              closeBuilderDrawer();
              renderBuilderPanel();
              renderBuilderThermalReceipt();
            }
          });
        });
      }

      function closeBuilderDrawer() {
        const backdrop = document.getElementById('builder-drawer-backdrop');
        backdrop?.classList.add('hidden');
        drawerTargetSlot = null;
      }

      function renderBuilderPanel() {
        const panel = document.getElementById('builder-panel');
        const tabs = document.getElementById('scenario-tabs-container');
        const header = document.getElementById('results-header');
        const results = document.getElementById('results-container');
        const toggleBtn = document.getElementById('btn-toggle-builder');
        const toggleLabel = document.getElementById('btn-builder-label');
        const slotsContainer = document.getElementById('builder-slots-container');

        if (!builderModeActive) {
          panel?.classList.add('hidden');
          tabs?.classList.remove('hidden');
          header?.classList.remove('hidden');
          results?.classList.remove('hidden');
          if (toggleBtn) {
            toggleBtn.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFE566] hover:bg-[#ffe043] border-2 border-[#111111] text-xs font-black shadow-[2px_2px_0px_0px_#111111] transition-all hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_0px_#111111] cursor-pointer text-[#111111]';
          }
          if (toggleLabel) toggleLabel.textContent = t('builderToggleBtn', currentLang);
          return;
        }

        syncBuilderSlotsLength();

        panel?.classList.remove('hidden');
        tabs?.classList.add('hidden');
        header?.classList.add('hidden');
        results?.classList.add('hidden');

        if (toggleBtn) {
          toggleBtn.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#111111] text-[#FFE566] border-2 border-[#111111] text-xs font-black shadow-[2px_2px_0px_0px_#111111] transition-all cursor-pointer ring-2 ring-[#FFE566]';
        }
        if (toggleLabel) toggleLabel.textContent = t('builderToggleBtnActive', currentLang);

        if (!slotsContainer) return;

        const minBuffer = parseInt((document.getElementById('input-buffer') as HTMLInputElement)?.value, 10) || 15;
        let html = '';

        for (let i = 0; i < builderSlots.length; i++) {
          const st = builderSlots[i];
          const isPinned = i === builderPinnedIndex;

          if (st) {
            const sStart = st.starts_at.split('T')[1].slice(0, 5);
            const sEnd = st.ends_at.split('T')[1].slice(0, 5);
            const ratings = movieRatingsMap[st.movie_title];
            const ratingBadge = renderAllocineRatingsBadge(ratings?.user_rating, ratings?.press_rating, false);

            const statusBadge = isPinned
              ? `<span class="bg-[#FFE566] text-[#111111] text-[0.65rem] font-black uppercase px-2 py-0.5 rounded border border-[#111111] shadow-[1px_1px_0px_0px_#111111] tracking-wider">${t('builderPinnedBadge', currentLang)}</span>`
              : `<span class="bg-[#A7F3D0] text-[#111111] text-[0.65rem] font-black uppercase px-2 py-0.5 rounded border border-[#111111] shadow-[1px_1px_0px_0px_#111111] tracking-wider">${t('builderAutoBadge', currentLang)}</span>`;

            let positionSwitcherHtml = '';
            if (isPinned) {
              const posButtons = [];
              for (let p = 0; p < builderSlots.length; p++) {
                const label = formatOrdinal(p + 1, currentLang);
                const activeCls = i === p ? 'bg-[#FFE566] border-[#111111]' : 'bg-white border-transparent text-[#555555]';
                posButtons.push(`<button type="button" class="btn-shift-pos px-1.5 py-0.5 text-[0.65rem] font-black rounded border cursor-pointer ${activeCls}" data-pos="${p}">${label}</button>`);
              }
              positionSwitcherHtml = `
                <div class="flex items-center gap-1 bg-[#FAFADF] border border-[#111111] rounded-[6px] p-0.5 shadow-[1px_1px_0px_0px_#111111]">
                  <span class="text-[0.65rem] font-bold text-[#555555] px-1 font-mono">${t('builderSlotPosPrefix', currentLang)}</span>
                  ${posButtons.join('')}
                </div>
              `;
            } else {
              positionSwitcherHtml = `
                <div class="flex items-center gap-1.5">
                  <button type="button" class="btn-open-slot-drawer neo-btn text-[0.7rem] font-bold bg-white hover:bg-[#FAFADF] text-[#111111] border border-[#111111] rounded-[4px] px-2 py-1 cursor-pointer shadow-[1px_1px_0px_0px_#111111]" data-slot-index="${i}">
                    ${t('builderChangeScreeningBtn', currentLang)}
                  </button>
                  <button type="button" class="btn-pin-slot neo-btn text-[0.7rem] font-bold bg-[#FAFADF] hover:bg-[#FFE566] text-[#111111] border border-[#111111] rounded-[4px] px-2 py-1 cursor-pointer shadow-[1px_1px_0px_0px_#111111]" data-slot-index="${i}" title="${t('builderLockSlotTitle', currentLang)}">
                    ${t('builderLockSlotBtn', currentLang)}
                  </button>
                </div>
              `;
            }

            const posterImg = st.poster_url
              ? `<img src="${st.poster_url}" alt="${escapeHtml(st.movie_title)}" class="w-12 h-16 sm:w-14 sm:h-20 object-cover rounded-[6px] border border-[#111111] shrink-0 shadow-[1px_1px_0px_0px_#111111]" loading="lazy" />`
              : `<div class="w-12 h-16 sm:w-14 sm:h-20 bg-[#FAFADF] border border-[#111111] rounded-[6px] flex items-center justify-center shrink-0 text-xs font-mono text-[#777777] shadow-[1px_1px_0px_0px_#111111]">film</div>`;

            html += `
              <div
                class="builder-slot-dropzone neo-card p-3 sm:p-4 bg-white border-2 border-[#111111] rounded-[12px] shadow-[3px_3px_0px_0px_#111111] ${isPinned ? 'ring-2 ring-[#FFE566]' : ''} transition-all"
                draggable="true"
                data-slot-index="${i}"
              >
                <div class="flex items-center justify-between border-b border-[#E5E5E5] pb-2 mb-2.5">
                  <div class="flex items-center gap-2">
                    <span class="drag-handle cursor-grab active:cursor-grabbing p-0.5 text-[#777777] hover:text-[#111111] shrink-0" title="${t('builderSlotDragTitle', currentLang)}">
                      ${iconGrip('w-3.5 h-3.5')}
                    </span>
                    <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-[#111111] text-[#FFE566] font-mono font-black text-xs">
                      0${i + 1}
                    </span>
                    <span class="text-xs font-black text-[#111111] font-sans">${t('builderSlotName', currentLang, { n: i + 1 })}</span>
                    ${statusBadge}
                  </div>
                  <div class="flex items-center gap-2">
                    ${positionSwitcherHtml}
                    <button type="button" class="btn-clear-slot w-6 h-6 rounded-full bg-[#FAFADF] hover:bg-[#E8635A] hover:text-white border border-[#111111] flex items-center justify-center text-xs font-black cursor-pointer transition-colors" data-slot-index="${i}" title="${t('builderClearSlotTitle', currentLang)}">
                      ✕
                    </button>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  ${posterImg}
                  <div class="min-w-0 flex-1">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h4 class="font-extrabold text-sm sm:text-base text-[#111111] font-sans truncate">${escapeHtml(st.movie_title)}</h4>
                      ${ratingBadge}
                    </div>
                    <div class="flex items-center gap-2 text-xs font-bold text-[#111111] mt-1 flex-wrap">
                      <span class="font-mono bg-[#FFE566] px-1.5 py-0.5 rounded border border-[#111111]">${sStart} - ${sEnd}</span>
                      <span class="bg-[#FAFADF] px-1.5 py-0.5 rounded border border-[#111111] truncate max-w-[180px]">${escapeHtml(st.cinema_name || '')}</span>
                      <span class="bg-white px-1.5 py-0.5 rounded border border-[#111111]">${escapeHtml(st.version || 'VF')}</span>
                      ${st.format && st.format !== 'Standard' ? `<span class="${isPremiumFormat(st.format) ? 'bg-[#FFE566] text-[#111111]' : 'bg-[#C4B5FD] text-[#111111]'} font-bold px-1.5 py-0.5 rounded border border-[#111111]">${escapeHtml(st.format)}</span>` : ''}
                    </div>
                  </div>
                </div>
              </div>
            `;
          } else {
            html += `
              <div
                class="builder-slot-dropzone btn-open-empty-slot p-4 border-2 border-dashed border-[#111111] rounded-[12px] bg-[#FAFADF]/60 hover:bg-[#FAFADF] transition-all cursor-pointer flex items-center justify-between gap-3 shadow-[2px_2px_0px_0px_#111111]"
                draggable="true"
                data-slot-index="${i}"
              >
                <div class="flex items-center gap-3">
                  <span class="drag-handle cursor-grab active:cursor-grabbing p-0.5 text-[#777777] hover:text-[#111111] shrink-0" title="${t('builderSlotDragTitle', currentLang)}">
                    ${iconGrip('w-3.5 h-3.5')}
                  </span>
                  <span class="inline-flex items-center justify-center w-6 h-6 rounded-full bg-white border border-[#111111] font-mono font-bold text-xs text-[#777777]">
                    0${i + 1}
                  </span>
                  <div>
                    <p class="font-black text-xs sm:text-sm text-[#111111] font-sans">${t('builderEmptySlotTitle', currentLang, { n: i + 1 })}</p>
                    <p class="text-[0.68rem] text-[#666666]">${t('builderEmptySlotHint', currentLang)}</p>
                  </div>
                </div>
                <span class="neo-btn px-2.5 py-1 rounded-[6px] bg-white border border-[#111111] text-xs font-bold text-[#111111] shadow-[1px_1px_0px_0px_#111111]">
                  ${t('builderBrowseBtn', currentLang)}
                </span>
              </div>
            `;
          }

          if (i < builderSlots.length - 1) {
            const nextSt = builderSlots[i + 1];
            if (st && nextSt) {
              const gapMin = Math.round((new Date(nextSt.starts_at).getTime() - new Date(st.ends_at).getTime()) / 60000);
              const isSameCin = st.cinema_id === nextSt.cinema_id;
              const isShort = gapMin < minBuffer;

              const connectorColor = isShort ? 'bg-[#F9A8B8]' : 'bg-[#FAFADF]';
              const labelText = isSameCin
                ? t('builderBreakSameCinema', currentLang, { gapMin })
                : t('builderBreakTransitCinema', currentLang, { gapMin });

              html += `
                <div class="flex items-center justify-center my-1.5">
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full ${connectorColor} border border-[#111111] text-[0.68rem] font-bold text-[#111111] shadow-[1px_1px_0px_0px_#111111]">
                    <span class="font-mono">${gapMin}m</span>
                    <span>&bull;</span>
                    <span>${labelText}</span>
                    ${isShort ? `<span class="bg-[#E8635A] text-white px-1 rounded text-[0.6rem] font-black">${t('builderBreakTooShort', currentLang)}</span>` : ''}
                  </div>
                </div>
              `;
            } else {
              html += `
                <div class="flex items-center justify-center my-1">
                  <div class="w-0.5 h-4 bg-[#111111]/30"></div>
                </div>
              `;
            }
          }
        }

        slotsContainer.innerHTML = html;

        // Position switcher clicks
        slotsContainer.querySelectorAll('.btn-shift-pos').forEach(btn => {
          btn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            const targetPos = parseInt(btn.getAttribute('data-pos') || '0', 10);
            shiftPinnedSlot(targetPos);
          });
        });

        // Open slot drawer
        slotsContainer.querySelectorAll('.btn-open-slot-drawer, .btn-open-empty-slot').forEach(el => {
          el.addEventListener('click', (ev) => {
            const target = ev.target as HTMLElement;
            if (target.closest('.drag-handle')) return;
            ev.stopPropagation();
            const slotIdx = parseInt(el.getAttribute('data-slot-index') || '0', 10);
            openBuilderDrawer(slotIdx);
          });
        });

        // Pin slot
        slotsContainer.querySelectorAll('.btn-pin-slot').forEach(btn => {
          btn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            const slotIdx = parseInt(btn.getAttribute('data-slot-index') || '0', 10);
            builderPinnedIndex = slotIdx;
            lastBuilderPinnedSignature = '';
            recomputeBuilderProposals(false);
            renderBuilderPanel();
            renderBuilderThermalReceipt();
          });
        });

        // Clear slot
        slotsContainer.querySelectorAll('.btn-clear-slot').forEach(btn => {
          btn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            const slotIdx = parseInt(btn.getAttribute('data-slot-index') || '0', 10);
            builderSlots[slotIdx] = null;
            lastBuilderPinnedSignature = '';
            renderBuilderPanel();
            renderBuilderThermalReceipt();
          });
        });

        // HTML5 Drag & Drop handlers on slot elements
        slotsContainer.querySelectorAll('.builder-slot-dropzone').forEach(dropzone => {
          const dz = dropzone as HTMLElement;
          const slotIdx = parseInt(dz.getAttribute('data-slot-index') || '0', 10);

          dz.addEventListener('dragstart', (ev) => {
            draggedSlotIndex = slotIdx;
            if (ev.dataTransfer) {
              ev.dataTransfer.effectAllowed = 'move';
              ev.dataTransfer.setData('text/plain', slotIdx.toString());
            }
            dz.classList.add('opacity-50', 'scale-[0.98]');
          });

          dz.addEventListener('dragend', () => {
            draggedSlotIndex = null;
            dz.classList.remove('opacity-50', 'scale-[0.98]');
            slotsContainer.querySelectorAll('.builder-slot-dropzone').forEach(el => {
              el.classList.remove('ring-4', 'ring-[#FFE566]', 'bg-[#FAFADF]');
            });
          });

          dz.addEventListener('dragover', (ev) => {
            ev.preventDefault();
            if (ev.dataTransfer) {
              ev.dataTransfer.dropEffect = 'move';
            }
            if (draggedSlotIndex !== null && draggedSlotIndex !== slotIdx) {
              dz.classList.add('ring-4', 'ring-[#FFE566]');
            }
          });

          dz.addEventListener('dragleave', () => {
            dz.classList.remove('ring-4', 'ring-[#FFE566]');
          });

          dz.addEventListener('drop', (ev) => {
            ev.preventDefault();
            dz.classList.remove('ring-4', 'ring-[#FFE566]');
            const srcIdx = draggedSlotIndex;
            const targetIdx = slotIdx;
            if (srcIdx !== null && srcIdx !== targetIdx && srcIdx >= 0 && srcIdx < builderSlots.length) {
              // Swap slots
              const tmp = builderSlots[srcIdx];
              builderSlots[srcIdx] = builderSlots[targetIdx];
              builderSlots[targetIdx] = tmp;

              if (builderPinnedIndex === srcIdx) {
                builderPinnedIndex = targetIdx;
              } else if (builderPinnedIndex === targetIdx) {
                builderPinnedIndex = srcIdx;
              }

              lastBuilderPinnedSignature = '';
              renderBuilderPanel();
              renderBuilderThermalReceipt();
            }
          });
        });
      }

      function renderBuilderThermalReceipt() {
        const receiptContainer = document.getElementById('thermal-receipt-container');
        if (!receiptContainer) return;

        const passFormula = (document.querySelector('input[name="pass-type"]:checked') as HTMLInputElement)?.value || 'Gold';
        const passTypeEnum = passFormula === 'Gold' ? PassType.GOLD : (passFormula === 'Silver' ? PassType.SILVER : PassType.UNDER26);

        if (!builderModeActive) {
          const currentActivePlan = calculatedPlans[activePlanIndex] || calculatedPlans[0] || null;
          receiptContainer.innerHTML = formatThermalReceiptHtml(currentActivePlan, passTypeEnum, currentLang);
          return;
        }

        const filledSlots = builderSlots.filter((s): s is Showtime => s !== null);
        if (filledSlots.length === 0) {
          receiptContainer.innerHTML = formatThermalReceiptHtml(null, passTypeEnum, currentLang);
          return;
        }

        filledSlots.sort((a, b) => a.starts_at.localeCompare(b.starts_at));

        let totalPause = 0;
        for (let i = 0; i < filledSlots.length - 1; i++) {
          const gap = (new Date(filledSlots[i + 1].starts_at).getTime() - new Date(filledSlots[i].ends_at).getTime()) / 60000;
          totalPause += Math.max(0, Math.round(gap));
        }

        let totalMovieMinutes = 0;
        for (const st of filledSlots) {
          const startMs = new Date(st.starts_at).getTime();
          const endMs = new Date(st.ends_at).getTime();
          if (!isNaN(startMs) && !isNaN(endMs)) {
            totalMovieMinutes += Math.max(0, Math.round((endMs - startMs) / 60000));
          }
        }

        const builderItinerary: Itinerary = {
          showtimes: filledSlots,
          total_movie_minutes: totalMovieMinutes,
          total_pause_minutes: totalPause,
          total_transit_minutes: 0,
          score: 100,
          has_meal_break: totalPause >= 45,
          estimated_cost_non_pass: filledSlots.length * 15.5,
          is_favorite_pick: false,
          unique_cinemas_count: new Set(filledSlots.map(s => s.cinema_id)).size,
        };

        receiptContainer.innerHTML = formatThermalReceiptHtml(builderItinerary, passTypeEnum, currentLang);

        const exportBtn = document.getElementById('btn-export-ics');
        if (exportBtn) {
          exportBtn.addEventListener('click', (ev) => {
            ev.stopPropagation();
            downloadIcsCalendar(builderItinerary);
          });
        }
      }

      function setupEventListeners() {
        // Language switcher buttons
        document.getElementById('btn-lang-fr')?.addEventListener('click', () => {
          applyLanguage('fr');
        });
        document.getElementById('btn-lang-en')?.addEventListener('click', () => {
          applyLanguage('en');
        });

        // Modal close listeners
        document.getElementById('btn-close-poster-modal')!.addEventListener('click', closePosterModal);
        document.getElementById('poster-modal')!.addEventListener('click', (ev) => {
          if (ev.target === document.getElementById('poster-modal')) {
            closePosterModal();
          }
        });
        document.addEventListener('keydown', (ev) => {
          if (ev.key === 'Escape') {
            closePosterModal();
            closeBuilderDrawer();
          }
        });

        // Builder / Composition Mode event listeners
        document.getElementById('btn-toggle-builder')?.addEventListener('click', () => {
          if (builderModeActive) {
            builderModeActive = false;
            renderBuilderPanel();
            renderBuilderThermalReceipt();
          } else {
            const target = Math.max(1, getTargetCount());
            const hasBuilderSlots = builderSlots.some(s => s !== null);
            if (hasBuilderSlots) {
              syncBuilderSlotsLength();
              builderModeActive = true;
              renderBuilderPanel();
              renderBuilderThermalReceipt();
            } else if (calculatedPlans[activePlanIndex]?.showtimes?.length) {
              const planSts = calculatedPlans[activePlanIndex].showtimes;
              builderSlots = new Array(target).fill(null);
              for (let i = 0; i < target; i++) {
                builderSlots[i] = planSts[i] || null;
              }
              builderPinnedIndex = 0;
              builderModeActive = true;
              renderBuilderPanel();
              renderBuilderThermalReceipt();
            } else {
              openStartMovieDrawer();
            }
          }
        });

        document.getElementById('btn-close-builder')?.addEventListener('click', () => {
          builderModeActive = false;
          renderBuilderPanel();
          renderBuilderThermalReceipt();
        });

        const btnRecompute = document.getElementById('btn-builder-recompute');
        btnRecompute?.addEventListener('click', () => {
          btnRecompute.classList.add('scale-95', 'bg-[#FFE566]');
          setTimeout(() => {
            btnRecompute.classList.remove('scale-95', 'bg-[#FFE566]');
          }, 150);
          recomputeBuilderProposals(true);
          renderBuilderPanel();
          renderBuilderThermalReceipt();
        });

        document.getElementById('btn-close-drawer')?.addEventListener('click', closeBuilderDrawer);
        document.getElementById('builder-drawer-backdrop')?.addEventListener('click', (ev) => {
          if (ev.target === document.getElementById('builder-drawer-backdrop')) {
            closeBuilderDrawer();
          }
        });

        const drawerFilterInput = document.getElementById('input-drawer-filter') as HTMLInputElement;
        drawerFilterInput?.addEventListener('input', () => {
          drawerFilterText = drawerFilterInput.value;
          if (drawerMode === 'choose_start_movie') {
            renderStartMovieDrawerList();
          } else {
            renderBuilderDrawerCandidates();
          }
        });

        document.getElementById('results-container')?.addEventListener('click', (ev) => {
          const btn = (ev.target as HTMLElement).closest('.btn-build-around') as HTMLElement;
          if (btn) {
            ev.stopPropagation();
            const title = btn.getAttribute('data-movie-title') || '';
            const cid = btn.getAttribute('data-cinema-id') || undefined;
            const starts = btn.getAttribute('data-starts-at') || undefined;
            startBuilderWithMovie(title, cid, starts);
          }
        });

        // Clear priority movies
        document.getElementById('btn-clear-priority')!.addEventListener('click', () => {
          selectedPriorityMovies.clear();
          renderPriorityMovies();
          scheduleRecalculate(0);
        });

        // Clear seen movies
        document.getElementById('btn-clear-seen')!.addEventListener('click', () => {
          selectedSeenMovies.clear();
          renderSeenMovies();
          renderPriorityMovies();
          scheduleRecalculate(0);
        });

        // Instant In-Place Filter for priority movies
        const priorityFilterInput = document.getElementById('input-priority-filter') as HTMLInputElement;
        priorityFilterInput.addEventListener('input', () => {
          prioritySearchFilter = priorityFilterInput.value;
          filterPriorityMoviesInPlace();
        });

        // Mobile filter panel toggle
        const toggleBtnMobile = document.getElementById('btn-toggle-filters-mobile');
        const filterPanelCard = document.getElementById('filter-panel-card');
        const textToggleFilters = document.getElementById('text-toggle-filters');

        if (toggleBtnMobile && filterPanelCard && textToggleFilters) {
          toggleBtnMobile.addEventListener('click', () => {
            const isHidden = filterPanelCard.classList.contains('hidden');
            if (isHidden) {
              filterPanelCard.classList.remove('hidden');
              textToggleFilters.textContent = currentLang === 'en' ? 'hide filters' : 'masquer filtres';
            } else {
              filterPanelCard.classList.add('hidden');
              textToggleFilters.textContent = currentLang === 'en' ? 'show filters' : 'afficher filtres';
            }
          });
        }

        // Quick Cinema Search Bar event with input debouncing
        const searchInput = document.getElementById('input-cinema-search') as HTMLInputElement;
        const clearBtn = document.getElementById('btn-clear-search') as HTMLButtonElement;
        let cinemaSearchDebounceTimer: ReturnType<typeof setTimeout> | null = null;

        searchInput.addEventListener('input', () => {
          cinemaSearchFilter = searchInput.value;
          if (cinemaSearchFilter) {
            clearBtn.classList.remove('hidden');
          } else {
            clearBtn.classList.add('hidden');
          }
          if (cinemaSearchDebounceTimer) clearTimeout(cinemaSearchDebounceTimer);
          cinemaSearchDebounceTimer = setTimeout(() => {
            renderCinemasList();
          }, 60);
        });

        clearBtn.addEventListener('click', () => {
          searchInput.value = '';
          cinemaSearchFilter = '';
          clearBtn.classList.add('hidden');
          renderCinemasList();
          searchInput.focus();
        });

        // Select all cinemas in current filter
        const btnToggleAll = document.getElementById('btn-select-all-city')!;
        btnToggleAll.addEventListener('click', () => {
          const checkboxes = document.querySelectorAll('.cinema-checkbox') as NodeListOf<HTMLInputElement>;
          const anyUnchecked = Array.from(checkboxes).some(cb => !cb.checked);
          checkboxes.forEach(cb => {
            cb.checked = anyUnchecked;
            if (anyUnchecked) {
              selectedCinemaIds.add(cb.value);
            } else {
              selectedCinemaIds.delete(cb.value);
            }
          });
          btnToggleAll.textContent = anyUnchecked ? t('deselectAll', currentLang) : t('selectAll', currentLang);
          updateSelectedCinemasCount();
          renderSelectedCinemasChips();
          renderPriorityMovies();
          scheduleRecalculate(0);
        });

        // Scenario tabs switching
        document.querySelectorAll('.scenario-tab').forEach(tab => {
          tab.addEventListener('click', () => {
            activeScenario = tab.getAttribute('data-scenario') || 'optimal';
            activePlanIndex = 0;
            updateScenarioTabsUI();
            scheduleRecalculate(0);
          });
        });

        const btnScopeAll = document.getElementById('btn-priority-scope-all');
        const btnScopeSelected = document.getElementById('btn-priority-scope-selected');
        if (btnScopeAll && btnScopeSelected) {
          btnScopeAll.addEventListener('click', () => {
            priorityMovieScope = 'all_day';
            renderPriorityMovies();
          });
          btnScopeSelected.addEventListener('click', () => {
            priorityMovieScope = 'selected';
            renderPriorityMovies();
          });
        }

        document.getElementById('select-city')!.addEventListener('change', () => {
          const citySelect = document.getElementById('select-city') as HTMLSelectElement;
          const selectedCity = citySelect.value;
          if (selectedCity !== 'Toutes') {
            // Remove cinemas from other cities
            for (const cid of Array.from(selectedCinemaIds)) {
              const cin = allCinemas.find(c => c.id === cid);
              if (cin && cin.city !== selectedCity) {
                selectedCinemaIds.delete(cid);
              }
            }
            // If none from this city are selected, select all cinemas in this city
            const cityCinemas = allCinemas.filter(c => c.city === selectedCity);
            const hasAnyInCity = cityCinemas.some(c => selectedCinemaIds.has(c.id));
            if (!hasAnyInCity && cityCinemas.length > 0) {
              cityCinemas.forEach(c => selectedCinemaIds.add(c.id));
            }
          }
          updateSelectedCinemasCount();
          renderSelectedCinemasChips();
          renderCinemasList();
          renderPriorityMovies();
          scheduleRecalculate(0);
        });

        document.getElementById('select-date')!.addEventListener('change', () => {
          onDateOrCinemaChanged();
        });

        document.querySelectorAll('input[name="pass-type"]').forEach(r => {
          r.addEventListener('change', () => scheduleRecalculate(0));
        });

        document.getElementById('check-supplements')!.addEventListener('change', () => scheduleRecalculate(0));

        document.querySelectorAll('input[name="lang-filter"]').forEach(r => {
          r.addEventListener('change', () => scheduleRecalculate(0));
        });

        document.querySelectorAll('.format-check').forEach(cb => {
          cb.addEventListener('change', () => scheduleRecalculate(0));
        });

        // Range count with debounced recalculation (smooth slider drag)
        const rangeCount = document.getElementById('range-count') as HTMLInputElement;
        let rangeDebounceTimer: ReturnType<typeof setTimeout> | null = null;
        rangeCount.addEventListener('input', () => {
          document.getElementById('target-count-val')!.textContent = t('targetCountText', currentLang, { n: rangeCount.value });
          if (rangeDebounceTimer) clearTimeout(rangeDebounceTimer);
          rangeDebounceTimer = setTimeout(() => {
            syncBuilderSlotsLength();
            if (builderModeActive) {
              lastBuilderPinnedSignature = '';
              recomputeBuilderProposals(false);
              renderBuilderPanel();
              renderBuilderThermalReceipt();
            }
            recalculate();
          }, 60);
        });

        document.getElementById('input-start')!.addEventListener('change', () => scheduleRecalculate(0));
        document.getElementById('input-end')!.addEventListener('change', () => scheduleRecalculate(0));
        document.getElementById('check-meal')!.addEventListener('change', () => scheduleRecalculate(0));
        document.getElementById('input-buffer')!.addEventListener('change', () => scheduleRecalculate(0));

        document.getElementById('btn-reset')!.addEventListener('click', () => {
          clearPreferences();
          location.reload();
        });
      }

      init();
    </script>
  </body>
</html>
