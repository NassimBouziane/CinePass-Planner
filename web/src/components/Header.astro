---
// Header.astro - Neobrutalism Ticket & Pop-Cine Header (No emojis, no tech jargon)
---
<header class="border-b-2 border-[#111111] bg-white sticky top-0 z-30 px-4 sm:px-6 lg:px-8 xl:px-12 py-3.5 shadow-[0_2px_0_0_#111111]">
  <div class="max-w-[1600px] mx-auto flex flex-col md:flex-row md:items-center justify-between gap-3">
    <!-- Brand / Title -->
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-[10px] bg-[#FFE566] border-2 border-[#111111] shadow-[2px_2px_0px_0px_#111111] flex items-center justify-center text-[#111111] shrink-0">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/>
          <path d="M13 5v2"/><path d="M13 11v2"/><path d="M13 17v2"/>
        </svg>
      </div>
      <div>
        <div class="flex items-center gap-2 flex-wrap">
          <h1 class="text-xl md:text-2xl font-extrabold tracking-tight text-[#111111] flex items-center gap-1.5 font-sans">
            cinépass <span class="bg-[#FFE566] px-2 py-0.5 border-2 border-[#111111] rounded-[6px] shadow-[2px_2px_0px_0px_#111111] rotate-[-1.5deg] inline-block text-base md:text-lg">planner</span>
          </h1>
          <span id="header-tagline" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[0.7rem] font-extrabold bg-[#C4B5FD] text-[#111111] border-2 border-[#111111] shadow-[1px_1px_0px_0px_#111111] tracking-wider lowercase">
            marathon en salle
          </span>
          <span id="header-handnote" class="font-hand text-lg text-[#E8635A] font-bold hidden sm:inline-block ml-1">
            optimise ta journée ciné !
          </span>
        </div>
        <p id="header-subtitle" class="text-xs text-[#555555] font-medium mt-0.5">
          enchaîne tes films préférés sans temps mort • cinémas et horaires du réseau cinépass
        </p>
      </div>
    </div>

    <!-- Sync status badge & Language Switcher -->
    <div class="flex items-center gap-3 self-start md:self-auto flex-wrap">
      <!-- Language Selector -->
      <div class="flex items-center bg-[#FAFADF] border-2 border-[#111111] rounded-full p-0.5 shadow-[2px_2px_0px_0px_#111111]">
        <button
          type="button"
          id="btn-lang-fr"
          class="btn-lang px-2.5 py-0.5 rounded-full text-xs font-mono font-black border border-transparent cursor-pointer bg-[#FFE566] text-[#111111] border-[#111111] transition-all"
          title="Passer en Français"
        >
          FR
        </button>
        <button
          type="button"
          id="btn-lang-en"
          class="btn-lang px-2.5 py-0.5 rounded-full text-xs font-mono font-black border border-transparent cursor-pointer text-[#555555] hover:text-[#111111] transition-all"
          title="Switch to English"
        >
          EN
        </button>
      </div>

      <!-- Sync Status -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#FAFADF] border-2 border-[#111111] text-xs font-bold shadow-[2px_2px_0px_0px_#111111]">
        <span class="w-2.5 h-2.5 rounded-full bg-[#4ECDC4] border border-[#111111] animate-pulse"></span>
        <span id="header-synced" class="font-mono text-[0.75rem]">séances synchronisées</span>
      </div>

      <!-- Mode Builder Toggle Button -->
      <button
        type="button"
        id="btn-toggle-builder"
        class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#FFE566] hover:bg-[#ffe043] border-2 border-[#111111] text-xs font-black shadow-[2px_2px_0px_0px_#111111] transition-all hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-[1px_1px_0px_0px_#111111] cursor-pointer text-[#111111]"
        title="Activer le Mode Builder pour composer votre marathon sur mesure"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
        </svg>
        <span id="btn-builder-label">mode builder</span>
      </button>

      <!-- Pop star vector icon -->
      <svg class="w-5 h-5 text-[#FFE566] hidden md:block" viewBox="0 0 24 24" fill="currentColor" stroke="#111111" stroke-width="1.5">
        <path d="M12 2L14.5 9.5L22 12L14.5 14.5L12 22L9.5 14.5L2 12L9.5 9.5L12 2Z" />
      </svg>
    </div>
  </div>
</header>
